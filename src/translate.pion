import "json"
import "pixels"
import "signals"
import "ui"
import "view"

struct TrRequest {
  verb : String
  url : String
  headers : String
  body : String
  timeout : Int
}

enum TrAnswer {
  TrDone(String)
  TrFailed(String)
}

struct TrBlock {
  x : Double
  y : Double
  w : Double
  h : Double
  lh : Double
  src : String
  text : String
}

struct TrShown {
  blocks : Array[TrBlock]
  key : String
  words : Array[OcrWord]
  full : String
}

enum PinTr {
  TrIdle
  TrWorking
  TrReady(TrShown)
  TrError(String)
}

let tr_providers : Array[String] = ["google", "deepseek", "openai"]

let tr_chunk_most : Int = 4000

fn trn(zh : String, arg : String) -> String {
  str_replace_all(tr(zh), "{}", arg)
}

fn tr_provider_name(p : String) -> String {
  match p {
    "google" => tr("Google 翻译")
    "deepseek" => "DeepSeek"
    "openai" => tr("OpenAI 兼容接口")
    _ => p
  }
}

fn tr_default_base(p : String) -> String {
  if p == "deepseek" { "https://api.deepseek.com/v1" } else { "https://api.openai.com/v1" }
}

fn tr_default_model(p : String) -> String {
  if p == "deepseek" { "deepseek-flash" } else { "gpt-4o-mini" }
}

fn tr_key_env(p : String) -> String {
  if p == "deepseek" { "DEEPSEEK_API_KEY" } else { "OPENAI_API_KEY" }
}

fn tr_key_of(s : Settings, p : String) -> String {
  if p == "deepseek" { s.tr_key_deepseek } else { s.tr_key_openai }
}

fn tr_model_of(s : Settings, p : String) -> String {
  if p == "deepseek" { s.tr_model_deepseek } else { s.tr_model_openai }
}

fn is_han(n : Int) -> Bool {
  (n >= 0x4E00 && n <= 0x9FFF) || (n >= 0x3400 && n <= 0x4DBF) || (n >= 0x20000 && n <= 0x2A6DF)
}

fn is_unspaced(n : Int) -> Bool {
  is_han(n) || (n >= 0x3040 && n <= 0x30FF) || (n >= 0x3000 && n <= 0x303F) || (n >= 0xFF00 && n <= 0xFFEF)
}

fn han_share(s : String) -> Double {
  let mut han = 0
  let mut other = 0
  for c in str_chars(s) {
    let n = c.to_int()
    if is_han(n) {
      han += 1
    } else if (n >= 0x41 && n <= 0x5A) ||
      (n >= 0x61 && n <= 0x7A) ||
      (n >= 0xC0 && n <= 0x24F) ||
      (n >= 0x370 && n <= 0x52F) ||
      (n >= 0x3040 && n <= 0x30FF) ||
      (n >= 0xAC00 && n <= 0xD7AF) {
      other += 1
    }
  }
  let words = han.to_double() + other.to_double() / 3.0
  if words <= 0.0 {
    0.0
  } else {
    han.to_double() / words
  }
}

fn tr_target_for(text : String) -> String {
  if han_share(text) >= 0.5 {
    "en"
  } else {
    "zh-CN"
  }
}

fn tr_lang_en(code : String) -> String {
  if str_has_prefix(code, "zh") { "Simplified Chinese" } else { "English" }
}

fn url_encode(s : String) -> String {
  let hex = "0123456789ABCDEF"
  let b = utf8_encode(s)
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    let c = b[i].to_int()
    if (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) ||
       c == 0x2D || c == 0x2E || c == 0x5F || c == 0x7E {
      sb.write_char(int_to_char(c))
    } else {
      sb.write_char('%')
      sb.write_char(int_to_char(hex.code_unit_at(c >> 4)))
      sb.write_char(int_to_char(hex.code_unit_at(c & 15)))
    }
  }
  sb.to_string()
}

fn google_request(text : String, target : String) -> TrRequest {
  {
    verb: "POST",
    url: "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=" + url_encode(target) + "&dt=t",
    headers: "Content-Type: application/x-www-form-urlencoded;charset=UTF-8",
    body: "q=" + url_encode(text),
    timeout: 10000,
  }
}

fn llm_prompt(target : String, lines : Int) -> String {
  "You are a translation engine. The user's message is text read by OCR from a screenshot: \{lines} numbered lines " +
  "(\"1. ...\"), each one block of the picture (a paragraph, a label, a name, a message). Translate each line on its " +
  "own into \{tr_lang_en(target)} and answer with exactly \{lines} lines, each starting with the same number and a " +
  "period, in the same order, never joining or splitting lines. Leave code, commands, paths, identifiers, numbers and " +
  "URLs as they are; a line with nothing to translate is given back as it is. Output only the numbered translations."
}

fn llm_request(base : String, model : String, key : String, text : String, target : String) -> TrRequest {
  let thinking = if str_contains(base, "deepseek.com") { "\"thinking\":{\"type\":\"disabled\"}," } else { "" }
  let q = fn(s : String) { json_stringify(json::Json::Str(s)) }
  let lines = text.split("\n")
  let numbered = StringBuilder::new()
  for i, l in lines {
    if i > 0 {
      numbered.write_char('\n')
    }
    numbered.write_string("\{i + 1}. " + l)
  }
  let body = "{\"model\":\{q(model)},\{thinking}\"stream\":false,\"messages\":[" +
    "{\"role\":\"system\",\"content\":\{q(llm_prompt(target, lines.length()))}}," +
    "{\"role\":\"user\",\"content\":\{q(numbered.to_string())}}]}"
  let mut url = trim_ws(base)
  while str_has_suffix(url, "/") {
    url = str_slice_bytes(url, 0, url.length() - 1)
  }
  {
    verb: "POST",
    url: url + "/chat/completions",
    headers: "Content-Type: application/json\r\nAuthorization: Bearer " + key,
    body,
    timeout: 45000,
  }
}

fn tr_api_key(s : Settings) -> String {
  let own = trim_ws(tr_key_of(s, s.tr_provider))
  if own != "" {
    own
  } else {
    trim_ws(ui::env(tr_key_env(s.tr_provider)))
  }
}

fn tr_request_for(s : Settings, text : String, target : String) -> Result[TrRequest, String] {
  let p = s.tr_provider
  if p == "google" {
    return Ok(google_request(text, target))
  }
  let key = tr_api_key(s)
  if key == "" {
    return Err(trn("还没填 {} 的 API Key：在设置 → 翻译里填写。", tr_provider_name(p)))
  }
  let base = if p == "openai" && trim_ws(s.tr_base) != "" { s.tr_base } else { tr_default_base(p) }
  let model = if trim_ws(tr_model_of(s, p)) != "" { trim_ws(tr_model_of(s, p)) } else { tr_default_model(p) }
  Ok(llm_request(base, model, key, text, target))
}

fn parse_google(body : String) -> TrAnswer {
  guard json_of(body) is Some(json::Json::Array(a)) && a.length() > 0 else {
    return TrFailed(tr("Google 翻译返回的内容看不懂。"))
  }
  let sb = StringBuilder::new()
  match a[0] {
    json::Json::Array(segs) => {
      for seg in segs {
        match seg {
          json::Json::Array(s) if s.length() > 0 =>
            match s[0] {
              json::Json::Str(t) => sb.write_string(t)
              _ => ()
            }
          _ => ()
        }
      }
    }
    _ => ()
  }
  let out = sb.to_string()
  if trim_ws(out) == "" {
    TrFailed(tr("Google 翻译没有给出译文。"))
  } else {
    TrDone(out)
  }
}

fn parse_llm(p : String, body : String) -> TrAnswer {
  let none = TrFailed(trn("{} 没有给出译文。", tr_provider_name(p)))
  guard json_of(body) is Some(json::Json::Object(o)) else {
    return TrFailed(trn("{} 返回的内容看不懂。", tr_provider_name(p)))
  }
  match o.get("choices") {
    Some(json::Json::Array(cs)) if cs.length() > 0 =>
      match cs[0] {
        json::Json::Object(c) =>
          match c.get("message") {
            Some(json::Json::Object(m)) => {
              let t = trim_ws(jstr(m, "content", ""))
              if t == "" { none } else { TrDone(t) }
            }
            _ => none
          }
        _ => none
      }
    _ => none
  }
}

fn tr_read_answer(p : String, status : Int, err : String, body : String) -> TrAnswer {
  let name = tr_provider_name(p)
  if status == 0 {
    return TrFailed(
      match err {
        "timeout" => trn("连接 {} 超时：检查网络或代理。", name)
        "dns" => trn("找不到 {} 的服务器：检查网络。", name)
        "connect" => trn("连不上 {}：检查网络或代理。", name)
        "tls" => trn("和 {} 的安全连接没有建立。", name)
        "url" => tr("接口地址要以 https:// 开头。")
        "large" | "memory" => trn("{} 返回的内容太大。", name)
        _ => trn("网络错误：没有连上 {}。", name)
      },
    )
  }
  if status != 200 {
    log("translate: \{p} answered \{status}: \{str_slice_bytes(body, 0, if body.length() > 200 { 200 } else { body.length() })}")
  }
  let named = fn(zh : String) { str_replace_all(trn(zh, name), "{n}", status.to_string()) }
  if status == 401 || status == 403 {
    return TrFailed(named("{} 拒绝了请求（{n}）：检查 API Key。"))
  }
  if status == 402 {
    return TrFailed(named("{} 账户余额不足（402）。"))
  }
  if status == 404 {
    return TrFailed(named("{} 找不到这个接口或模型（404）：检查接口地址和模型名。"))
  }
  if status == 429 {
    return TrFailed(named("{} 说请求太频繁或额度用完了（429），稍后再试。"))
  }
  if status >= 500 {
    return TrFailed(named("{} 暂时不可用（{n}），稍后再试。"))
  }
  if status != 200 {
    return TrFailed(named("{} 返回了 {n}。"))
  }
  if p == "google" {
    parse_google(body)
  } else {
    parse_llm(p, body)
  }
}

fn tr_split_answer(answer : String, n : Int) -> Array[String] {
  let got : Array[String] = []
  for l in answer.split("\n") {
    let t = trim_ws(l)
    if t != "" {
      got.push(t)
    }
  }
  if got.length() == n || n <= 0 {
    return got
  }
  let out : Array[String] = []
  if got.length() > n {
    for k in 0..<(n - 1) {
      out.push(got[k])
    }
    let sb = StringBuilder::new()
    for k in (n - 1)..<got.length() {
      if k > n - 1 {
        sb.write_char(' ')
      }
      sb.write_string(got[k])
    }
    out.push(sb.to_string())
  } else {
    for g in got {
      out.push(g)
    }
    while out.length() < n {
      out.push("")
    }
  }
  out
}

/// The numbered lines of a model's answer ("3. ...") put back in their places; lines it lost stay empty. None where
/// it numbered none of them.
fn tr_numbered_answer(answer : String, n : Int) -> Option[Array[String]] {
  let out : Array[String] = []
  for _ in 0..<n {
    out.push("")
  }
  let mut found = 0
  for raw in answer.split("\n") {
    let l = trim_ws(raw)
    let cs = str_chars(l)
    let mut i = 0
    let mut num = 0
    while i < cs.length() && cs[i].to_int() >= 0x30 && cs[i].to_int() <= 0x39 && i < 6 {
      num = num * 10 + (cs[i].to_int() - 0x30)
      i += 1
    }
    if i == 0 || i >= cs.length() {
      continue
    }
    let sep = cs[i].to_int()
    if sep != 0x2E && sep != 0xFF0E && sep != 0x3001 && sep != 0x29 && sep != 0x3A && sep != 0xFF1A {
      continue
    }
    if num < 1 || num > n {
      continue
    }
    out[num - 1] = trim_ws(chars_to_string(cs, i + 1, cs.length()))
    found += 1
  }
  if found == 0 { None } else { Some(out) }
}

// ---- requests ----

let tr_id : signals::Ref[Int] = signals::ref_new(0)

let tr_waiting : Map[Int, (String, (TrAnswer) -> Unit)] = Map::new()

fn tr_http(text : String, target : String, done : (TrAnswer) -> Unit) -> Unit {
  let s = settings.untracked()
  match tr_request_for(s, text, target) {
    Err(why) => done(TrFailed(why))
    Ok(r) => {
      tr_id.v += 1
      let id = tr_id.v
      tr_waiting[id] = (s.tr_provider, done)
      log("translate \{id}: \{s.tr_provider}, \{str_chars(text).length()} chars to \{target}")
      if ps_http(id, r.verb, r.url, r.headers, r.body, r.timeout) == 0 {
        tr_waiting.remove(id)
        done(TrFailed(tr("接口地址要以 https:// 开头。")))
      }
    }
  }
}

fn http_told(o : json::JsonObject, body : Option[Bytes]) -> Unit {
  let id = jnum(o, "id", -1.0).to_int()
  guard tr_waiting.get(id) is Some((p, done)) else { return }
  tr_waiting.remove(id)
  let status = jnum(o, "status", 0.0).to_int()
  let err = jstr(o, "err", "")
  let text = match body {
    Some(b) => text_of(b)
    None => ""
  }
  log("translate \{id}: status \{status} '\{err}', \{text.length()} bytes")
  done(tr_read_answer(p, status, err, text))
}

/// `lines` translated, in pieces of at most tr_chunk_most characters one after another; each piece's answer put back
/// line for line.
fn tr_lines_translated(
  lines : Array[String],
  target : String,
  done : (Result[Array[String], String]) -> Unit,
) -> Unit {
  let pieces : Array[(Int, Int)] = []
  let mut start = 0
  let mut size = 0
  for i, l in lines {
    let n = str_chars(l).length() + 1
    if i > start && size + n > tr_chunk_most {
      pieces.push((start, i))
      start = i
      size = 0
    }
    size += n
  }
  if start < lines.length() {
    pieces.push((start, lines.length()))
  }
  let out : Array[String] = []
  let llm = settings.untracked().tr_provider != "google"
  let step : signals::Ref[(Int) -> Unit] = signals::ref_new(fn(_) { () })
  step.v = fn(k : Int) {
    if k >= pieces.length() {
      done(Ok(out))
      return
    }
    let (a, b) = pieces[k]
    let sb = StringBuilder::new()
    for i in a..<b {
      if i > a {
        sb.write_char('\n')
      }
      sb.write_string(lines[i])
    }
    tr_http(sb.to_string(), target, fn(ans) {
      match ans {
        TrFailed(why) => done(Err(why))
        TrDone(text) => {
          let parts = if llm {
            match tr_numbered_answer(text, b - a) {
              Some(v) => v
              None => tr_split_answer(text, b - a)
            }
          } else {
            tr_split_answer(text, b - a)
          }
          for i in 0..<(b - a) {
            out.push(if i < parts.length() { parts[i] } else { "" })
          }
          (step.v)(k + 1)
        }
      }
    })
  }
  (step.v)(0)
}

// ---- the picture's words as blocks ----

struct TrLine {
  x0 : Double
  y0 : Double
  x1 : Double
  y1 : Double
  text : String
}

fn tr_lines(words : Array[OcrWord]) -> Array[TrLine] {
  let out : Array[TrLine] = []
  let mut i = 0
  while i < words.length() {
    let line = words[i].line
    let start = i
    let mut x0 = 1.0
    let mut y0 = 1.0
    let mut x1 = 0.0
    let mut y1 = 0.0
    while i < words.length() && words[i].line == line {
      let w = words[i]
      x0 = dmin(x0, w.x)
      y0 = dmin(y0, w.y)
      x1 = dmax(x1, w.x + w.w)
      y1 = dmax(y1, w.y + w.h)
      i += 1
    }
    out.push(TrLine::{ x0: x0, y0: y0, x1: x1, y1: y1, text: ocr_text_range(words, start, i - 1) })
  }
  out
}

fn tr_join(a : String, b : String) -> String {
  let ca = str_chars(a)
  let cb = str_chars(b)
  if ca.length() == 0 {
    return b
  }
  if cb.length() == 0 {
    return a
  }
  let last = ca[ca.length() - 1].to_int()
  let first = cb[0].to_int()
  if last == 0x2D && ca.length() > 1 && !is_unspaced(ca[ca.length() - 2].to_int()) {
    chars_to_string(ca, 0, ca.length() - 1) + b
  } else if is_unspaced(last) || is_unspaced(first) {
    a + b
  } else {
    a + " " + b
  }
}

fn tr_blocks(words : Array[OcrWord], px_w : Double, px_h : Double) -> Array[TrBlock] {
  let lines = tr_lines(words)
  let out : Array[TrBlock] = []
  let mut i = 0
  while i < lines.length() {
    let first = lines[i]
    let mut x0 = first.x0
    let mut y0 = first.y0
    let mut x1 = first.x1
    let mut y1 = first.y1
    let mut text = first.text
    let lh = first.y1 - first.y0
    let mut lh_sum = lh
    let mut n = 1
    let mut prev = first
    i += 1
    while i < lines.length() {
      let l = lines[i]
      let h = l.y1 - l.y0
      let avg = lh_sum / n.to_double()
      let gap = l.y0 - prev.y1
      let same_size = h <= avg * 1.3 && h >= avg / 1.3
      let near = gap >= -avg * 0.3 && gap <= avg * 0.75
      let left = (l.x0 - x0).abs() * px_w <= avg * px_h * 1.6
      let overlap = dmin(l.x1, x1) - dmax(l.x0, x0) > 0.0
      if !(same_size && near && left && overlap) {
        break
      }
      x0 = dmin(x0, l.x0)
      y0 = dmin(y0, l.y0)
      x1 = dmax(x1, l.x1)
      y1 = dmax(y1, l.y1)
      text = tr_join(text, l.text)
      lh_sum += h
      n += 1
      prev = l
      i += 1
    }
    let size = if n > 1 {
      dmax((prev.y0 - first.y0) / (n - 1).to_double() * 0.72, lh_sum / n.to_double() * 0.9)
    } else {
      lh
    }
    out.push({ x: x0, y: y0, w: x1 - x0, h: y1 - y0, lh: size, src: text, text: "" })
  }
  out
}

fn tr_same(a : String, b : String) -> Bool {
  let squeeze = fn(s : String) {
    let sb = StringBuilder::new()
    for c in str_chars(s) {
      let n = c.to_int()
      if n > 0x20 && n != 0x3000 {
        sb.write_char(if n >= 0x41 && n <= 0x5A { int_to_char(n + 32) } else { c })
      }
    }
    sb.to_string()
  }
  b == "" || squeeze(a) == squeeze(b)
}

fn tr_one_line(s : String) -> String {
  str_replace_all(str_replace_all(str_replace_all(s, "\r", " "), "\n", " "), "\t", " ")
}

/// What the native drawing is told: one row per block, "x y w h size draw text" (tabs), positions as shares of the
/// picture; a block whose translation is its own words is not drawn, only laid out for selecting.
fn tr_spec(blocks : Array[TrBlock]) -> String {
  let sb = StringBuilder::new()
  for b in blocks {
    let same = tr_same(b.src, b.text)
    sb.write_string("\{b.x}\t\{b.y}\t\{b.w}\t\{b.h}\t\{b.lh}\t\{if same { 0 } else { 1 }}\t")
    sb.write_string(tr_one_line(if same { b.src } else { b.text }))
    sb.write_char('\n')
  }
  sb.to_string()
}

fn tr_parse_words(raw : String) -> Array[OcrWord] {
  let out : Array[OcrWord] = []
  for row in raw.split("\n") {
    let parts : Array[String] = row.split("\t")
    if parts.length() < 8 {
      continue
    }
    let sb = StringBuilder::new()
    for i in 7..<parts.length() {
      if i > 7 {
        sb.write_char('\t')
      }
      sb.write_string(parts[i])
    }
    let text = sb.to_string()
    if text == "" {
      continue
    }
    let x = clamp(parse_double_or(parts[3], 0.0), 0.0, 1.0)
    let y = clamp(parse_double_or(parts[4], 0.0), 0.0, 1.0)
    out.push(OcrWord::{
      line: parse_int_or(parts[0], 0),
      para: parse_int_or(parts[1], 0),
      space: parts[2] != "0",
      x,
      y,
      w: clamp(parse_double_or(parts[5], 0.0), 0.0, 1.0 - x),
      h: clamp(parse_double_or(parts[6], 0.0), 0.0, 1.0 - y),
      text,
    })
  }
  out
}

let tr_words_got : Map[Int, Array[OcrWord]] = Map::new()

fn tr_words_told(o : json::JsonObject, bytes : Option[Bytes]) -> Unit {
  let req = jnum(o, "id", -1.0).to_int()
  if tr_drawing.get(req).is_none() {
    return
  }
  tr_words_got[req] = match bytes {
    Some(b) => tr_parse_words(text_of(b))
    None => []
  }
}

fn tr_full_text(blocks : Array[TrBlock]) -> String {
  let sb = StringBuilder::new()
  for i, b in blocks {
    if i > 0 {
      sb.write_char('\n')
    }
    sb.write_string(if b.text != "" { b.text } else { b.src })
  }
  sb.to_string()
}

// ---- a pin's translation ----

let tr_drawing : Map[Int, (Int, Array[TrBlock])] = Map::new()

fn pin_tr_text(p : Pin) -> String {
  match p.tr.untracked() {
    TrReady(s) => s.full
    _ => ""
  }
}

fn pin_tr_forget(p : Pin) -> Unit {
  match p.tr.untracked() {
    TrReady(s) => ui::forget_image(s.key)
    _ => ()
  }
}

fn pin_tr_clear(p : Pin) -> Unit {
  p.tr_req.v = 0
  p.tr_wanted.v = false
  pin_tr_forget(p)
  signals::start_batch()
  p.tr_on.set(false)
  p.tr.set(TrIdle)
  p.ocr_sel.set(None)
  p.ocr_hover.set(-1)
  signals::end_batch()
}

fn pin_translate(p : Pin) -> Unit {
  match p.tr.untracked() {
    TrReady(_) => {
      p.tr_on.set(true)
      return
    }
    TrWorking => return
    _ => ()
  }
  match p.ocr.untracked() {
    PinOcr::Ready(ws, _) if ws.length() > 0 => ()
    PinOcr::Ready(_, _) | PinOcr::Failed(_) => {
      if !p.ocr_on.untracked() {
        p.ocr_on.set(true)
      }
      p.tr.set(TrError(tr("没有可以翻译的文字")))
      return
    }
    _ => {
      p.tr_wanted.v = true
      pin_start_ocr(p)
      return
    }
  }
  guard p.ocr.untracked() is PinOcr::Ready(words, _) else { return }
  p.tr_wanted.v = false
  if !p.ocr_on.untracked() {
    pin_start_ocr(p)
  }
  let pic = shown_picture(p)
  let (pw, ph) = match pixels::image_size(pic) {
    Some(v) => v
    None => (p.w, p.h)
  }
  let blocks = tr_blocks(words, pw.to_double(), ph.to_double())
  if blocks.length() == 0 {
    p.tr.set(TrError(tr("没有可以翻译的文字")))
    return
  }
  let lines : Array[String] = []
  for b in blocks {
    lines.push(tr_one_line(b.src))
  }
  let target = tr_target_for(lines.join("\n"))
  signals::start_batch()
  p.tr.set(TrWorking)
  p.tr_on.set(true)
  p.ocr_sel.set(None)
  p.ocr_hover.set(-1)
  signals::end_batch()
  let wid = p.wid.v
  tr_id.v += 1
  let req = tr_id.v
  p.tr_req.v = req
  tr_lines_translated(lines, target, fn(got) {
    guard pin_of_wid(wid) is Some((_, q)) && q.tr_req.v == req else { return }
    match got {
      Ok(parts) => {
        let filled : Array[TrBlock] = []
        for i, b in blocks {
          filled.push({ ..b, text: if i < parts.length() { parts[i] } else { "" } })
        }
        tr_drawing[req] = (wid, filled)
        if ps_tr_render(req, pic, tr_spec(filled), if str_has_prefix(target, "zh") { 1 } else { 0 }) == 0 {
          tr_drawing.remove(req)
          pin_tr_failed(q, tr("译文没画出来。"))
        }
      }
      Err(why) => pin_tr_failed(q, why)
    }
  })
}

fn pin_tr_failed(p : Pin, why : String) -> Unit {
  p.tr_req.v = 0
  signals::start_batch()
  p.tr.set(TrError(why))
  p.tr_on.set(false)
  signals::end_batch()
  toast(why)
}

fn tr_pic_told(o : json::JsonObject, bytes : Option[Bytes]) -> Unit {
  let req = jnum(o, "id", -1.0).to_int()
  guard tr_drawing.get(req) is Some((wid, blocks)) else { return }
  tr_drawing.remove(req)
  guard pin_of_wid(wid) is Some((_, p)) && p.tr_req.v == req else { return }
  let words = match tr_words_got.get(req) {
    Some(v) => v
    None => []
  }
  tr_words_got.remove(req)
  let pic = match bytes {
    Some(v) if jnum(o, "ok", 0.0) != 0.0 && v.length() > 0 => v
    _ => {
      log("translate \{req}: drawing failed '\{jstr(o, "why", "")}'")
      pin_tr_failed(p, tr("译文没画出来。"))
      return
    }
  }
  let key = "tr:\{wid}:\{req}"
  ui::add_image(key, pic)
  pin_tr_forget(p)
  p.tr_req.v = 0
  signals::start_batch()
  p.ocr_sel.set(None)
  p.ocr_hover.set(-1)
  p.tr.set(TrReady(TrShown::{ blocks: blocks, key: key, words: words, full: tr_full_text(blocks) }))
  signals::end_batch()
  log("translate \{req}: drawn, \{words.length()} words")
}

fn pin_toggle_translate(p : Pin) -> Unit {
  match p.tr.untracked() {
    TrWorking => {
      pin_tr_clear(p)
      return
    }
    _ => ()
  }
  signals::start_batch()
  p.ocr_sel.set(None)
  p.ocr_hover.set(-1)
  signals::end_batch()
  if p.tr_on.untracked() {
    p.tr_on.set(false)
  } else {
    match p.tr.untracked() {
      TrError(_) => p.tr.set(TrIdle)
      _ => ()
    }
    pin_translate(p)
  }
}

/// The picture the pin shows: the translated one while the translation is on.
fn pin_shown_key(p : Pin) -> String {
  if p.tr_on.get() {
    match p.tr.get() {
      TrReady(s) => return s.key
      _ => ()
    }
  }
  p.key.get()
}

// ---- settings ----

let tr_save_gen : signals::Ref[Int] = signals::ref_new(0)

fn translate_page(p : view::View) -> Unit {
  let key_field : ui::Field = ui::Field::new()
  let base_field : ui::Field = ui::Field::new()
  let model_field : ui::Field = ui::Field::new()
  let fill = fn() {
    let s = settings.untracked()
    key_field.set(tr_key_of(s, s.tr_provider))
    base_field.set(s.tr_base)
    model_field.set(tr_model_of(s, s.tr_provider))
  }
  fill()
  let provider = fn() { settings.get().tr_provider }
  p.reacts(fn() { settings.get().tr_provider }, at_start=false, fn(_) { fill() })
  // (typed in without being written at each key: kept, then written once the typing stops)
  let quietly = fn(f : (Settings) -> Settings) {
    settings.set(f(settings.untracked()))
    tr_save_gen.v += 1
    let g = tr_save_gen.v
    let _ = p.at_moment(p.cause_at() + 700.0, fn() {
      if g == tr_save_gen.v {
        save_settings()
      }
    }, later=true)
  }
  let input = fn(r : view::View, f : ui::Field, hint : () -> String, secret : Bool, set : (String) -> Unit) {
    let _ = r.box(fn(wrap) {
      let _ = wrap
      .width(view::Live::Is(Some(240.0)))
      .shrink(view::Live::Is(0.0))
      .padding(view::Live::Is((10.0, 6.0, 10.0, 6.0)))
      .radius(view::Live::Is(8.0))
      .ground(view::Live::Is(0x141518FFL))
      .edge(view::Live::By(fn() { (1.0, if f.focused() { 0x2F9BFFFFL } else { 0xFFFFFF24L }) }))
      let node = ui::field(
        wrap,
        f,
        placeholder_by=hint,
        font_size=12.5,
        line=17.0,
        max_lines=1,
        color=set_ink,
        placeholder_color=0x7E8594FFL,
        caret_color=0x2F9BFFFFL,
        secret~,
        trim=true,
        edited=fn(t) { set(trim_ws(t)) },
      )
      ignore(node)
    })
  }
  set_group(p, "", fn(g) {
    set_row(g, "翻译服务", fn(r) {
      choice(r, ["Google", "DeepSeek", "OpenAI 兼容"], fn() {
        match provider() {
          "deepseek" => 1
          "openai" => 2
          _ => 0
        }
      }, fn(i) { change_settings(fn(s) { Settings::{ ..s, tr_provider: tr_providers[i] } }) })
    }, note=fn() {
      match provider() {
        "google" => tr("免费、不用 Key（Google 网页翻译接口，尽力而为）；点「翻译」时才把识别出的文字发给 Google")
        _ => tr("用你自己的 API Key；点「翻译」时才把识别出的文字发给这个服务")
      }
    }, note_ink=fn() { set_muted })
    let _ = g.box(fn(more) {
      let _ = more.laid_nowhere(view::Live::By(fn() { provider() == "google" }))
      set_row(more, "API Key", fn(r) {
        input(r, key_field, fn() {
          let env = tr_key_env(provider())
          if trim_ws(ui::env(env)) != "" { trn("留空则用环境变量 {}", env) } else { "sk-…" }
        }, true, fn(t) {
          quietly(fn(s) {
            if s.tr_provider == "deepseek" {
              Settings::{ ..s, tr_key_deepseek: t }
            } else {
              Settings::{ ..s, tr_key_openai: t }
            }
          })
        })
      }, note=fn() { tr("只存在本机的设置文件里") }, note_ink=fn() { set_muted })
      let _ = more.box(fn(oa) {
        let _ = oa.laid_nowhere(view::Live::By(fn() { provider() != "openai" }))
        set_row(oa, "接口地址", fn(r) {
          input(r, base_field, fn() { tr_default_base("openai") }, false, fn(t) {
            quietly(fn(s) { Settings::{ ..s, tr_base: t } })
          })
        })
      })
      set_row(more, "模型", fn(r) {
        input(r, model_field, fn() { tr_default_model(provider()) }, false, fn(t) {
          quietly(fn(s) {
            if s.tr_provider == "deepseek" {
              Settings::{ ..s, tr_model_deepseek: t }
            } else {
              Settings::{ ..s, tr_model_openai: t }
            }
          })
        })
      })
    })
  })
}

test "translation requests and answers" {
  assert_eq(url_encode("a b&中"), "a%20b%26%E4%B8%AD")
  assert_eq(tr_target_for("Hello world"), "zh-CN")
  assert_eq(tr_target_for("你好，世界"), "en")
  assert_eq(tr_target_for("darksky 7:13 PM\n确实，感觉可以顺便把 bob 干掉"), "en")
  assert_true(tr_same("7: 07 PM", "7:07 pm"))
  assert_true(!tr_same("Settings", "设置"))
  let g = google_request("Hi", "zh-CN")
  assert_true(str_contains(g.url, "tl=zh-CN"))
  assert_eq(g.body, "q=Hi")
  let l = llm_request("https://api.deepseek.com/v1/", "deepseek-flash", "sk-x", "Hi\nthere", "zh-CN")
  assert_eq(l.url, "https://api.deepseek.com/v1/chat/completions")
  assert_true(str_contains(l.body, "\"thinking\":{\"type\":\"disabled\"}"))
  assert_true(str_contains(l.body, "exactly 2 lines"))
  assert_true(str_contains(l.body, "1. Hi\\n2. there"))
  assert_true(str_contains(l.headers, "Bearer sk-x"))
  match parse_google("[[[\"你好\",\"Hello\",null],[\"世界\",\" world\",null]],null,\"en\"]") {
    TrDone(t) => assert_eq(t, "你好世界")
    TrFailed(_) => assert_true(false)
  }
  match tr_read_answer("openai", 200, "", "{\"choices\":[{\"message\":{\"content\":\" 好 \"}}]}") {
    TrDone(t) => assert_eq(t, "好")
    TrFailed(_) => assert_true(false)
  }
  assert_true(tr_read_answer("openai", 401, "", "") is TrFailed(_))
  assert_true(tr_read_answer("google", 0, "timeout", "") is TrFailed(_))
  match tr_numbered_answer("2. 二\n1. 一\n4. 多余", 3) {
    Some(v) => assert_true(v[0] == "一" && v[1] == "二" && v[2] == "")
    None => assert_true(false)
  }
  assert_true(tr_numbered_answer("没有编号", 2) is None)
}

test "translation blocks from OCR lines" {
  let sample = "0\t0\t0.10\t0.10\t0.30\t0.05\tThe quick brown\n1\t0\t0.10\t0.16\t0.25\t0.05\tfox jumps.\n" +
    "2\t0\t0.10\t0.40\t0.10\t0.09\tTitle\n3\t0\t0.60\t0.70\t0.05\t0.05\t你\n3\t0\t0.65\t0.70\t0.05\t0.05\t好\n"
  let ws = ocr_parse_boxes(sample)
  let bs = tr_blocks(ws, 400.0, 400.0)
  assert_eq(bs.length(), 3)
  assert_eq(bs[0].src, "The quick brown fox jumps.")
  assert_eq(bs[1].src, "Title")
  assert_eq(bs[2].src, "你好")
  // (a tall picture: lines a little apart sideways, in pixels, still one paragraph)
  let tall = "0\t0\t0.100\t0.100\t0.50\t0.0125\tone line of a\n1\t0\t0.115\t0.115\t0.50\t0.0125\tparagraph here\n"
  assert_eq(tr_blocks(ocr_parse_boxes(tall), 400.0, 1600.0).length(), 1)
  assert_eq(tr_join("inter-", "national"), "international")
  assert_eq(tr_join("你好", "世界"), "你好世界")
  let parts = tr_split_answer("一\n\n二\n三\n四", 3)
  assert_eq(parts.length(), 3)
  assert_eq(parts[2], "三 四")
  let fewer = tr_split_answer("一", 2)
  assert_eq(fewer.length(), 2)
  assert_eq(fewer[1], "")
  let spec = tr_spec([{ x: 0.1, y: 0.2, w: 0.3, h: 0.1, lh: 0.04, src: "a\tb", text: "甲\n乙" }])
  assert_true(str_contains(spec, "\t1\t甲 乙\n"))
  let back = tr_parse_words("0\t2\t1\t0.1\t0.2\t0.05\t0.03\tword\nbad row\n")
  assert_eq(back.length(), 1)
  assert_true(back[0].para == 2 && back[0].space && back[0].text == "word")
}
