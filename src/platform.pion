fn parse_double_or(s : String, fallback : Double) -> Double {
  let t = trim_ws(s)
  if t == "" {
    return fallback
  }
  let n = t.length()
  let mut i = 0
  let mut sign = 1.0
  if t.code_unit_at(0) == 45 {
    sign = -1.0
    i = 1
  } else if t.code_unit_at(0) == 43 {
    i = 1
  }
  let mut whole = 0.0
  let mut frac = 0.0
  let mut div = 1.0
  let mut seen_dot = false
  let mut seen_digit = false
  while i < n {
    let c = t.code_unit_at(i)
    if c >= 48 && c <= 57 {
      seen_digit = true
      let d = (c - 48).to_double()
      if seen_dot {
        div = div * 10.0
        frac = frac + d / div
      } else {
        whole = whole * 10.0 + d
      }
      i += 1
    } else if c == 46 && !seen_dot {
      seen_dot = true
      i += 1
    } else {
      return fallback
    }
  }
  if !seen_digit { fallback } else { sign * (whole + frac) }
}

fn parse_int_or(s : String, fallback : Int) -> Int {
  match trim_ws(s).to_int() {
    Some(v) => v
    None => fallback
  }
}

fn trim_ws(s : String) -> String {
  let n = s.length()
  let mut lo = 0
  while lo < n {
    let c = s.code_unit_at(lo)
    if c == 32 || c == 9 || c == 10 || c == 13 { lo += 1 } else { break }
  }
  let mut hi = n
  while hi > lo {
    let c = s.code_unit_at(hi - 1)
    if c == 32 || c == 9 || c == 10 || c == 13 { hi -= 1 } else { break }
  }
  if lo == 0 && hi == n { s } else { str_slice_bytes(s, lo, hi) }
}

fn str_slice_bytes(s : String, start : Int, end : Int) -> String {
  let lo = if start < 0 { 0 } else if start > s.length() { s.length() } else { start }
  let hi = if end < lo { lo } else if end > s.length() { s.length() } else { end }
  let sb = StringBuilder::new()
  let mut i = lo
  while i < hi {
    sb.write_byte(s.code_unit_at(i) as Byte)
    i += 1
  }
  sb.to_string()
}

fn str_to_ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32) as Byte)
    } else {
      sb.write_byte(c as Byte)
    }
    i += 1
  }
  sb.to_string()
}

fn str_has_prefix(s : String, pre : String) -> Bool {
  ui::str_has_prefix(s, pre)
}

fn str_has_suffix(s : String, suf : String) -> Bool {
  let n = s.length()
  let m = suf.length()
  if m > n {
    return false
  }
  let mut i = 0
  while i < m {
    if s.code_unit_at(n - m + i) != suf.code_unit_at(i) {
      return false
    }
    i += 1
  }
  true
}

fn str_contains(s : String, pat : String) -> Bool {
  ui::str_contains(s, pat)
}

fn str_replace_all(s : String, old : String, rep : String) -> String {
  if old == "" {
    return s
  }
  let parts = s.split(old)
  if parts.length() <= 1 {
    return s
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < parts.length() {
    if i > 0 {
      sb.write_string(rep)
    }
    sb.write_string(parts[i])
    i += 1
  }
  sb.to_string()
}

fn bytes_from_arr(arr : Array[Byte]) -> Bytes {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < arr.length() {
    sb.write_byte(arr[i])
    i += 1
  }
  sb.to_string().to_bytes()
}

fn bytes_from_fixed(arr : FixedArray[Byte]) -> Bytes {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < arr.length() {
    sb.write_byte(arr[i])
    i += 1
  }
  sb.to_string().to_bytes()
}

fn make_array[T](n : Int, v : T) -> Array[T] {
  let out : Array[T] = []
  let mut i = 0
  while i < n {
    out.push(v)
    i += 1
  }
  out
}

fn numbers_of(s : String) -> Array[Double] {
  let out : Array[Double] = []
  let parts = s.split(",")
  let mut i = 0
  while i < parts.length() {
    out.push(parse_double_or(parts[i], 0.0))
    i += 1
  }
  out
}

fn json_of(s : String) -> Option[json::Json] {
  match json::parse(s) {
    Ok(v) => Some(v)
    Err(_) => None
  }
}

fn jnum(o : json::JsonObject, k : String, fallback : Double) -> Double {
  match o.get(k) {
    Some(json::Json::Float(v)) => v
    Some(json::Json::Int(n)) => n.to_double()
    _ => fallback
  }
}

fn jstr(o : json::JsonObject, k : String, fallback : String) -> String {
  match o.get(k) {
    Some(json::Json::Str(s)) => s
    _ => fallback
  }
}

fn jbool(o : json::JsonObject, k : String, fallback : Bool) -> Bool {
  match o.get(k) {
    Some(json::Json::Bool(b)) => b
    _ => fallback
  }
}

fn json_num(v : Double) -> json::Json {
  json::Json::Float(v)
}

fn json_bool(b : Bool) -> json::Json {
  json::Json::Bool(b)
}

fn json_str(s : String) -> json::Json {
  json::Json::Str(s)
}

fn json_obj_map(m : Map[String, json::Json]) -> json::Json {
  let pairs : Array[(String, json::Json)] = []
  for k in m.keys() {
    match m.get(k) {
      Some(v) => pairs.push((k, v))
      None => ()
    }
  }
  json::Json::obj(pairs)
}

fn json_stringify(j : json::Json) -> String {
  match json::stringify(j) {
    Ok(s) => s
    Err(_) => ""
  }
}

fn println(s : String) -> Unit {
  let b = s.to_bytes()
  c_ps_stdout(bytes_data_ptr(b), b.length().to_int64())
}

fn shortcut_mod() -> Int {
  if ui::keys_system() == 0 { ui::mod_cmd } else { ui::mod_ctrl }
}

fn file_in(dir : String, name : String) -> String {
  dir + (if hostapi::platform() == 3 { "\\" } else { "/" }) + name
}

fn assert_eq[T](a : T, b : T) -> Unit {
  debug_assert(a == b, "assert_eq failed")
}

fn assert_true(b : Bool) -> Unit {
  debug_assert(b, "assert_true failed")
}

fn assert_false(b : Bool) -> Unit {
  debug_assert(!b, "assert_false failed")
}
