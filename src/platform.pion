extern "C" fn c_mb_bytes_len(p : Ptr) -> Int = "pion_mb_bytes_len"
extern "C" fn c_mb_decref(p : Ptr) -> Unit = "moonbit_decref"

fn take_mb_bytes(p : Ptr) -> Bytes {
  let n = c_mb_bytes_len(p)
  let b = if n > 0 { bytes_from_ptr(p, n) } else { "".to_bytes() }
  c_mb_decref(p)
  b
}

fn utf8_encode(s : String) -> Bytes {
  s.to_bytes()
}

fn cstr(s : String) -> Bytes {
  let b = s.to_bytes()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    sb.write_byte(b[i])
    i += 1
  }
  sb.write_byte(0 as Byte)
  sb.to_string().to_bytes()
}

fn text_of(b : Bytes) -> String {
  let sb = StringBuilder::new()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c0 = b[i].to_int()
    if c0 < 0x80 {
      sb.write_char(int_to_char(c0))
      i += 1
    } else if (c0 & 0xE0) == 0xC0 && i + 1 < n {
      let c1 = b[i + 1].to_int()
      if (c1 & 0xC0) == 0x80 {
        let cp = ((c0 & 0x1F) << 6) | (c1 & 0x3F)
        if cp >= 0x80 {
          sb.write_char(int_to_char(cp))
          i += 2
        } else {
          sb.write_char('\u{FFFD}')
          i += 1
        }
      } else {
        sb.write_char('\u{FFFD}')
        i += 1
      }
    } else if (c0 & 0xF0) == 0xE0 && i + 2 < n {
      let c1 = b[i + 1].to_int()
      let c2 = b[i + 2].to_int()
      if (c1 & 0xC0) == 0x80 && (c2 & 0xC0) == 0x80 {
        let cp = ((c0 & 0x0F) << 12) | ((c1 & 0x3F) << 6) | (c2 & 0x3F)
        if cp >= 0x800 && (cp < 0xD800 || cp > 0xDFFF) {
          sb.write_char(int_to_char(cp))
          i += 3
        } else {
          sb.write_char('\u{FFFD}')
          i += 1
        }
      } else {
        sb.write_char('\u{FFFD}')
        i += 1
      }
    } else if (c0 & 0xF8) == 0xF0 && i + 3 < n {
      let c1 = b[i + 1].to_int()
      let c2 = b[i + 2].to_int()
      let c3 = b[i + 3].to_int()
      if (c1 & 0xC0) == 0x80 && (c2 & 0xC0) == 0x80 && (c3 & 0xC0) == 0x80 {
        let cp = ((c0 & 0x07) << 18) | ((c1 & 0x3F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F)
        if cp >= 0x10000 && cp <= 0x10FFFF {
          sb.write_char(int_to_char(cp))
          i += 4
        } else {
          sb.write_char('\u{FFFD}')
          i += 1
        }
      } else {
        sb.write_char('\u{FFFD}')
        i += 1
      }
    } else {
      sb.write_char('\u{FFFD}')
      i += 1
    }
  }
  sb.to_string()
}

fn int_to_char(cp : Int) -> Char {
  if cp >= 0 && cp <= 0x10FFFF && (cp < 0xD800 || cp > 0xDFFF) {
    cp.unsafe_to_char()
  } else {
    '\u{FFFD}'
  }
}

fn str_chars(s : String) -> Array[Char] {
  let out : Array[Char] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push(int_to_char(c0))
      i += 1
    } else if (c0 & 0xE0) == 0xC0 && i + 1 < n {
      let c1 = s.code_unit_at(i + 1)
      out.push(int_to_char(((c0 & 0x1F) << 6) | (c1 & 0x3F)))
      i += 2
    } else if (c0 & 0xF0) == 0xE0 && i + 2 < n {
      let c1 = s.code_unit_at(i + 1)
      let c2 = s.code_unit_at(i + 2)
      out.push(int_to_char(((c0 & 0x0F) << 12) | ((c1 & 0x3F) << 6) | (c2 & 0x3F)))
      i += 3
    } else if (c0 & 0xF8) == 0xF0 && i + 3 < n {
      let c1 = s.code_unit_at(i + 1)
      let c2 = s.code_unit_at(i + 2)
      let c3 = s.code_unit_at(i + 3)
      out.push(int_to_char(((c0 & 0x07) << 18) | ((c1 & 0x3F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F)))
      i += 4
    } else {
      out.push('\u{FFFD}')
      i += 1
    }
  }
  out
}

fn chars_to_string(cs : Array[Char], lo : Int, hi : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = if lo < 0 { 0 } else { lo }
  let end = if hi > cs.length() { cs.length() } else { hi }
  while i < end {
    sb.write_char(cs[i])
    i += 1
  }
  sb.to_string()
}

