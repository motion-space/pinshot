import "hostapi"
import "pixels"
import "signals"
import "ui"
import "view"

struct Pin {
  wid : signals::Ref[Int]
  png : Bytes
  first_w : Int
  first_h : Int
  mut turns : Int
  mut flipped : Bool
  key : signals::Signal[String]
  key_first : String
  mut w : Int
  mut h : Int
  zx : signals::Signal[Double]
  zy : signals::Signal[Double]
  alpha : signals::Signal[Int]
  top : signals::Signal[Bool]
  zoomed_at : signals::Signal[Double]
  active : signals::Signal[Bool]
  active_at : signals::Signal[Double]
  flash : signals::Signal[Double]
  edge : signals::Signal[Int]
  sizing : signals::Ref[Option[PinSizing]]
  ocr_on : signals::Signal[Bool]
  ocr : signals::Signal[PinOcr]
  ocr_sel : signals::Signal[Option[(Int, Int)]]
  ocr_hover : signals::Signal[Int]
  ocr_copied_at : signals::Signal[Double]
  ocr_req : signals::Ref[Int]
  ocr_from_capture : signals::Ref[Bool]
  ocr_selecting : signals::Ref[Bool]
  ocr_anchor : signals::Ref[Int]
  ocr_down_on_word : signals::Ref[Bool]
  ocr_down_x : signals::Ref[Double]
  ocr_down_y : signals::Ref[Double]
  ocr_drag_moved : signals::Ref[Bool]
  ocr_click_at : signals::Ref[Double]
  ocr_click_word : signals::Ref[Int]
  ocr_clicks : signals::Ref[Int]
  shelve : signals::Ref[Bool]
}

struct PinSizing {
  edge : Int
  x : Double
  y : Double
  w : Double
  h : Double
  zx : Double
  zy : Double
  px : Double
  py : Double
}

let pins : Map[String, Pin] = Map::new()

let pin_n : signals::Ref[Int] = signals::ref_new(0)

let pins_hidden : signals::Ref[Bool] = signals::ref_new(false)

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  for i in 0..<n {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

fn find_pin_by_png(png : Bytes) -> Option[Pin] {
  for what in pins.keys() {
    match pins.get(what) {
      Some(p) if bytes_eq(p.png, png) => return Some(p)
      _ => ()
    }
  }
  None
}

fn open_pin(png : Bytes, x : Int, y : Int, w : Int, h : Int, zoom~ : Double = 1.0, start_ocr~ : Bool = false) -> Unit {
  match find_pin_by_png(png) {
    Some(existing) => {
      let cloaked = ui::env("PINSHOT_TEST_CLOAKED") != ""
      let top = if existing.top.untracked() { 1 } else { 0 }
      ps_topmost(existing.wid.v, top, if cloaked { 0 } else { 1 })
      if pins_hidden.v {
        ps_place_show(existing.wid.v)
        pins_hidden.v = false
      }
      pin_active(existing.wid.v, true)
      if start_ocr && !existing.ocr_on.untracked() {
        pin_start_ocr(existing, from_capture=true)
      }
      log("pin \{w}x\{h} already open -> focused (\{pins.length()} open)")
      return
    }
    None => ()
  }
  pin_n.v += 1
  let what = "pin:\{pin_n.v}"
  let key = "mem:" + what
  ui::add_image(key, png)
  let s = settings.untracked()
  let p : Pin = Pin::{
    wid: signals::ref_new(0),
    png,
    first_w: w,
    first_h: h,
    turns: 0,
    flipped: false,
    key: signals::signal(key),
    key_first: key,
    w,
    h,
    zx: signals::signal(zoom),
    zy: signals::signal(zoom),
    alpha: signals::signal(s.pin_alpha),
    top: signals::signal(s.pin_top),
    zoomed_at: signals::signal(-10000.0),
    active: signals::signal(false),
    active_at: signals::signal(-10000.0),
    flash: signals::signal(0.0),
    edge: signals::signal(0),
    sizing: signals::ref_new(None),
    ocr_on: signals::signal(false),
    ocr: signals::signal_ref(Idle),
    ocr_sel: signals::signal_by(None, same=fn(a, b) {
      match (a, b) {
        (None, None) => true
        (Some((x0, y0)), Some((x1, y1))) => x0 == x1 && y0 == y1
        _ => false
      }
    }),
    ocr_hover: signals::signal(-1),
    ocr_copied_at: signals::signal(-10000.0),
    ocr_req: signals::ref_new(0),
    ocr_from_capture: signals::ref_new(start_ocr),
    ocr_selecting: signals::ref_new(false),
    ocr_anchor: signals::ref_new(-1),
    ocr_down_on_word: signals::ref_new(false),
    ocr_down_x: signals::ref_new(0.0),
    ocr_down_y: signals::ref_new(0.0),
    ocr_drag_moved: signals::ref_new(false),
    ocr_click_at: signals::ref_new(-10000.0),
    ocr_click_word: signals::ref_new(-1),
    ocr_clicks: signals::ref_new(0),
    shelve: signals::ref_new(true),
  }
  pins[what] = p
  let wid = ui::window_open_here(what)
  if wid <= 0 {
    println("pin: no window (\{pins.length()} open)")
    pins.remove(what)
    ui::forget_image(key)
    return
  }
  p.wid.v = wid
  let _ = ps_own(wid, if s.pin_top { 1 } else { 0 })
  ps_shadow(wid)
  let (pw, ph) = if zoom == 1.0 {
    (w, h)
  } else {
    (dmax(16.0, (w.to_double() * zoom).round()).to_int(), dmax(16.0, (h.to_double() * zoom).round()).to_int())
  }
  let cloaked = ui::env("PINSHOT_TEST_CLOAKED") != ""
  if cloaked {
    ps_cloak(wid, 1)
  }
  ps_place(wid, x, y, pw, ph, 1, if cloaked { 0 } else { 1 })
  if s.pin_alpha < 255 {
    ps_opacity(wid, s.pin_alpha)
  }
  pins_hidden.v = false
  if start_ocr {
    pin_start_ocr(p, from_capture=true)
  }
  log("pin \{w}x\{h} opened (\{pins.length()} open)")
}

fn pin_clipboard() -> Unit {
  let b = if ui::env("PINSHOT_TEST_NO_CLIP") != "" {
    bytes_from_arr([])
  } else if ui::env("PINSHOT_TEST_PIN_FILE") != "" {
    ps_read_file(cstr(ui::env("PINSHOT_TEST_PIN_FILE")))
  } else {
    ps_clipboard_image()
  }
  guard b.length() > 0 && pixels::image_size(b) is Some((w, h)) else {
    log("pin: no picture on the clipboard")
    toast(tr("剪贴板里没有图片"))
    return
  }
  let p = numbers_of(text_of(ps_pointer()))
  let (x, y) = if p.length() == 2 { (p[0].to_int() - w / 2, p[1].to_int() - h / 2) } else { (100, 100) }
  open_pin(b, x, y, w, h)
}

fn pin_of_wid(wid : Int) -> Option[(String, Pin)] {
  for what in pins.keys() {
    match pins.get(what) {
      Some(p) if p.wid.v == wid => return Some((what, p))
      _ => ()
    }
  }
  None
}

fn close_pin(wid : Int) -> Unit {
  guard pin_of_wid(wid) is Some((_, p)) else { return }
  if p.shelve.v {
    p.shelve.v = false
    shelve_pin(p)
  }
  close_window(wid)
}

fn pin_gone(wid : Int) -> Unit {
  guard pin_of_wid(wid) is Some((what, p)) else { return }
  pin_ocr_clear_pending(p)
  pins.remove(what)
  pin_roots.remove(wid)
  ui::forget_image(p.key.untracked())
  if p.key.untracked() != p.key_first {
    ui::forget_image(p.key_first)
  }
  trim_soon()
}

fn pins_to_front() -> Unit {
  for what in pins.keys() {
    match pins.get(what) {
      Some(p) => {
        ps_topmost(p.wid.v, if p.top.untracked() { 1 } else { 0 }, 0)
        ps_place_show(p.wid.v)
      }
      None => ()
    }
  }
  pins_hidden.v = false
}

fn pins_toggle() -> Unit {
  if pins.length() == 0 {
    return
  }
  if pins_hidden.v {
    pins_to_front()
  } else {
    for what in pins.keys() {
      match pins.get(what) {
        Some(p) => ps_hide(p.wid.v)
        None => ()
      }
    }
    pins_hidden.v = true
  }
}

fn ps_place_show(wid : Int) -> Unit {
  let r = numbers_of(text_of(ps_window_rect(wid)))
  if r.length() >= 4 {
    ps_place(wid, r[0].to_int(), r[1].to_int(), r[2].to_int(), r[3].to_int(), 1, 0)
  }
}

fn zoom_pin(p : Pin, zx : Double, zy : Double) -> Unit {
  let zx = clamp(zx, 0.1, 8.0)
  let zy = clamp(zy, 0.1, 8.0)
  let r = numbers_of(text_of(ps_window_rect(p.wid.v)))
  if r.length() < 4 {
    return
  }
  let (x, y, w, h) = (r[0], r[1], r[2], r[3])
  let nw = dmax(16.0, (p.w.to_double() * zx).round())
  let nh = dmax(16.0, (p.h.to_double() * zy).round())
  let q = numbers_of(text_of(ps_pointer()))
  let (ax, ay) = if q.length() == 2 && q[0] >= x && q[0] < x + w && q[1] >= y && q[1] < y + h {
    (q[0], q[1])
  } else {
    (x + w / 2.0, y + h / 2.0)
  }
  let nx = ax - (ax - x) * nw / w
  let ny = ay - (ay - y) * nh / h
  signals::start_batch()
  p.zx.set(zx)
  p.zy.set(zy)
  p.zoomed_at.set(now_of(p))
  signals::end_batch()
  ps_place(p.wid.v, nx.round().to_int(), ny.round().to_int(), nw.to_int(), nh.to_int(), 0, 0)
  p.edge.set(pin_edge(p))
}

fn scale_pin(p : Pin, k : Double) -> Unit {
  let (zx, zy) = (p.zx.untracked(), p.zy.untracked())
  let k = clamp(k, dmax(0.1 / zx, 0.1 / zy), dmin(8.0 / zx, 8.0 / zy))
  let r = fn(z : Double) { (z * k * 100.0).round() / 100.0 }
  zoom_pin(p, r(zx), r(zy))
}

fn orient_pin(p : Pin, turns : Int, flipped : Bool, zx : Double, zy : Double) -> Unit {
  let r = numbers_of(text_of(ps_window_rect(p.wid.v)))
  if r.length() < 4 {
    return
  }
  let turns = turns % 4
  let old = p.key.untracked()
  let key = if turns == 0 && !flipped {
    if old != p.key_first {
      ui::add_image(p.key_first, p.png)
    }
    p.key_first
  } else {
    let native = ps_picture_oriented(p.png, turns, if flipped { 1 } else { 0 }, 1)
    let shown = if native.length() > 0 {
      native
    } else {
      guard picture_rgba(p.png) is Some((w, h, px)) else {
        log("pin: its picture could not be read to turn it")
        return
      }
      let (tw, th, out) = oriented(w, h, px, turns, flipped)
      shown_bytes(tw, th, out)
    }
    pin_key_n.v += 1
    let key = p.key_first + ":" + pin_key_n.v.to_string()
    ui::add_image(key, shown)
    key
  }
  p.turns = turns
  p.flipped = flipped
  let odd = turns % 2 == 1
  p.w = if odd { p.first_h } else { p.first_w }
  p.h = if odd { p.first_w } else { p.first_h }
  p.key.set(key)
  if old != key {
    ui::forget_image(old)
  }
  let (cx, cy) = (r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
  let zx = clamp(zx, 0.1, 8.0)
  let zy = clamp(zy, 0.1, 8.0)
  let nw = dmax(16.0, (p.w.to_double() * zx).round())
  let nh = dmax(16.0, (p.h.to_double() * zy).round())
  signals::start_batch()
  p.zx.set(zx)
  p.zy.set(zy)
  p.zoomed_at.set(now_of(p))
  signals::end_batch()
  ps_place(p.wid.v, (cx - nw / 2.0).round().to_int(), (cy - nh / 2.0).round().to_int(), nw.to_int(), nh.to_int(), 0, 0)
  pin_ocr_clear_pending(p)
  p.ocr_selecting.v = false
  signals::start_batch()
  p.ocr.set(Idle)
  p.ocr_sel.set(None)
  p.ocr_hover.set(-1)
  signals::end_batch()
  if p.ocr_on.untracked() {
    pin_start_ocr(p)
  }
  p.edge.set(pin_edge(p))
}

let pin_key_n : signals::Ref[Int] = signals::ref_new(0)

fn turn_pin(p : Pin, cw : Bool) -> Unit {
  orient_pin(p, p.turns + (if cw { 1 } else { 3 }), p.flipped, p.zy.untracked(), p.zx.untracked())
}

fn flip_pin(p : Pin, across : Bool) -> Unit {
  let t = (if across { 4 } else { 6 }) - p.turns
  orient_pin(p, t, !p.flipped, p.zx.untracked(), p.zy.untracked())
}

fn reset_pin(p : Pin) -> Unit {
  if p.turns == 0 && !p.flipped {
    zoom_pin(p, 1.0, 1.0)
  } else {
    orient_pin(p, 0, false, 1.0, 1.0)
  }
}

fn pin_as_pinned(p : Pin) -> Bool {
  p.turns == 0 && !p.flipped && p.zx.untracked() == 1.0 && p.zy.untracked() == 1.0
}

fn shown_picture(p : Pin) -> Bytes {
  if p.turns == 0 && !p.flipped {
    return p.png
  }
  let native = ps_picture_oriented(p.png, p.turns, if p.flipped { 1 } else { 0 }, 0)
  if native.length() > 0 {
    return native
  }
  guard picture_rgba(p.png) is Some((w, h, px)) else { return p.png }
  let (tw, th, out) = oriented(w, h, px, p.turns, p.flipped)
  pixels::png(tw, th, pixels::bytes_to_fixed(out))
}

fn oriented(
  w : Int,
  h : Int,
  px : Bytes,
  turns : Int,
  flipped : Bool,
) -> (Int, Int, Bytes) {
  let (tw, th) = if turns % 2 == 1 { (h, w) } else { (w, h) }
  let out = Array::make(w * h * 4, (0x00 as Byte))
  for y in 0..<h {
    for x0 in 0..<w {
      let x = if flipped { w - 1 - x0 } else { x0 }
      let (nx, ny) = match turns {
        1 => (h - 1 - y, x)
        2 => (w - 1 - x, h - 1 - y)
        3 => (y, w - 1 - x)
        _ => (x, y)
      }
      let i = (y * w + x0) * 4
      let o = (ny * tw + nx) * 4
      out[o] = px[i]
      out[o + 1] = px[i + 1]
      out[o + 2] = px[i + 2]
      out[o + 3] = px[i + 3]
    }
  }
  (tw, th, bytes_from_arr(out))
}

fn shown_bytes(w : Int, h : Int, px : Bytes) -> Bytes {
  let n = w * h
  let mut solid = true
  for i in 0..<n {
    if px[i * 4 + 3] != (0xff as Byte) {
      solid = false
      break
    }
  }
  if !solid || hostapi::platform() != 3 {
    return pixels::png(w, h, pixels::bytes_to_fixed(px))
  }
  let size = 54 + n * 4
  let b = Array::make(size, (0x00 as Byte))
  let le32 = fn(at : Int, v : Int) {
    b[at] = (v & 0xFF).to_byte()
    b[at + 1] = ((v >> 8) & 0xFF).to_byte()
    b[at + 2] = ((v >> 16) & 0xFF).to_byte()
    b[at + 3] = ((v >> 24) & 0xFF).to_byte()
  }
  b[0] = (66 as Byte)
  b[1] = (77 as Byte)
  le32(2, size)
  le32(10, 54)
  le32(14, 40)
  le32(18, w)
  le32(22, -h)
  b[26] = (0x01 as Byte)
  b[28] = (0x20 as Byte)
  le32(34, n * 4)
  for i in 0..<n {
    let s = i * 4
    let o = 54 + s
    b[o] = px[s + 2]
    b[o + 1] = px[s + 1]
    b[o + 2] = px[s]
    b[o + 3] = (0xff as Byte)
  }
  bytes_from_arr(b)
}

fn picture_rgba(b : Bytes) -> Option[(Int, Int, Bytes)] {
  match pixels::decode_png(b) {
    Some((w, h, px)) => Some((w, h, bytes_from_fixed(px)))
    None =>
      match pixels::decode_jpeg(b) {
        Some((w, h, px)) => Some((w, h, bytes_from_fixed(px)))
        None => bmp_rgba(b)
      }
  }
}

fn bmp_rgba(b : Bytes) -> Option[(Int, Int, Bytes)] {
  let n = b.length()
  let u8 = fn(i : Int) -> Int { if i >= 0 && i < n { b[i].to_int() } else { 0 } }
  let le32 = fn(i : Int) -> Int { u8(i) | (u8(i + 1) << 8) | (u8(i + 2) << 16) | (u8(i + 3) << 24) }
  if n < 54 || u8(0) != 0x42 || u8(1) != 0x4D {
    return None
  }
  let off = le32(10)
  let w = le32(18)
  let h0 = le32(22)
  let bpp = u8(28) | (u8(29) << 8)
  let comp = le32(30)
  let (h, down) = if h0 < 0 { (-h0, true) } else { (h0, false) }
  if w <= 0 || h <= 0 || (bpp != 32 && bpp != 24) || (comp != 0 && comp != 3) || (comp == 3 && bpp != 32) {
    return None
  }
  if comp == 3 && (le32(54) != 0x00FF0000 || le32(58) != 0x0000FF00 || le32(62) != 0x000000FF) {
    return None
  }
  let bpx = bpp / 8
  let stride = (w * bpx + 3) / 4 * 4
  if off + stride * h > n {
    return None
  }
  let mut any_alpha = false
  if bpp == 32 {
    for y in 0..<h {
      for x in 0..<w {
        if u8(off + y * stride + x * 4 + 3) != 0 {
          any_alpha = true
          break
        }
      }
      if any_alpha {
        break
      }
    }
  }
  let out = Array::make(w * h * 4, (0xff as Byte))
  for y in 0..<h {
    let row = off + (if down { y } else { h - 1 - y }) * stride
    for x in 0..<w {
      let i = row + x * bpx
      let o = (y * w + x) * 4
      out[o] = b[i + 2]
      out[o + 1] = b[i + 1]
      out[o + 2] = b[i]
      if bpp == 32 && any_alpha {
        out[o + 3] = b[i + 3]
      }
    }
  }
  Some((w, h, bytes_from_arr(out)))
}

fn pin_pointer_uv(p : Pin) -> (Int, Double, Double, Double, Double) {
  let r = numbers_of(text_of(ps_window_rect(p.wid.v)))
  let q = numbers_of(text_of(ps_pointer()))
  if r.length() < 5 || q.length() < 2 {
    return (0, -1.0, -1.0, 0.0, 0.0)
  }
  let (x, y, w, h) = (r[0], r[1], r[2], r[3])
  let (px, py) = (q[0] - x, q[1] - y)
  if w <= 0.0 || h <= 0.0 || px < 0.0 || py < 0.0 || px >= w || py >= h {
    return (0, -1.0, -1.0, w, h)
  }
  let band = 8.0 * dmax(r[4], 96.0) / 96.0
  let bx = dmin(band, w / 4.0)
  let by = dmin(band, h / 4.0)
  let ex = if px < bx { 1 } else if px >= w - bx { 2 } else { 0 }
  let ey = if py < by { 4 } else if py >= h - by { 8 } else { 0 }
  (ex | ey, px / w, py / h, w, h)
}

fn pin_edge(p : Pin) -> Int {
  let (e, _, _, _, _) = pin_pointer_uv(p)
  e
}

fn edge_cursor(e : Int) -> view::Cursor {
  match e {
    5 | 10 => view::Cursor::ResizeNWSE
    6 | 9 => view::Cursor::ResizeNESW
    1 | 2 => view::Cursor::ResizeX
    4 | 8 => view::Cursor::ResizeY
    _ => view::Cursor::Arrow
  }
}

fn size_pin(p : Pin, s : PinSizing) -> Unit {
  let q = numbers_of(text_of(ps_pointer()))
  if q.length() < 2 || s.w <= 0.0 || s.h <= 0.0 {
    return
  }
  let (dx, dy) = (q[0] - s.px, q[1] - s.py)
  let (l, r, t, b) = ((s.edge & 1) != 0, (s.edge & 2) != 0, (s.edge & 4) != 0, (s.edge & 8) != 0)
  let sx = (s.w + (if r { dx } else if l { -dx } else { 0.0 })) / s.w
  let sy = (s.h + (if b { dy } else if t { -dy } else { 0.0 })) / s.h
  let across = l || r
  let down = t || b
  let keep_aspect = ps_shift_down() == 0
  let (kx, ky) = if keep_aspect {
    let raw = if across && down {
      (sx * s.w * s.w + sy * s.h * s.h) / (s.w * s.w + s.h * s.h)
    } else if across {
      sx
    } else {
      sy
    }
    let k_lo = dmax(dmax(0.1 / s.zx, 0.1 / s.zy), dmax(16.0 / s.w, 16.0 / s.h))
    let k_hi = dmin(8.0 / s.zx, 8.0 / s.zy)
    let k = clamp(raw, k_lo, dmax(k_lo, k_hi))
    (k, k)
  } else {
    (if across { sx } else { 1.0 }, if down { sy } else { 1.0 })
  }
  let zx = clamp(s.zx * kx, 0.1, 8.0)
  let zy = clamp(s.zy * ky, 0.1, 8.0)
  let nw = dmax(16.0, (p.w.to_double() * zx).round())
  let nh = dmax(16.0, (p.h.to_double() * zy).round())
  let nx = if l {
    s.x + s.w - nw
  } else if r {
    s.x
  } else if keep_aspect {
    s.x + (s.w - nw) / 2.0
  } else {
    s.x
  }
  let ny = if t {
    s.y + s.h - nh
  } else if b {
    s.y
  } else if keep_aspect {
    s.y + (s.h - nh) / 2.0
  } else {
    s.y
  }
  signals::start_batch()
  p.zx.set(zx)
  p.zy.set(zy)
  p.zoomed_at.set(now_of(p))
  signals::end_batch()
  ps_place(p.wid.v, nx.round().to_int(), ny.round().to_int(), nw.to_int(), nh.to_int(), 0, 0)
}

let pin_roots : Map[Int, view::View] = Map::new()

fn now_of(p : Pin) -> Double {
  match pin_roots.get(p.wid.v) {
    Some(r) => r.cause_at()
    None => 0.0
  }
}

fn set_alpha(p : Pin, a : Int) -> Unit {
  let a = clampi(a, 25, 255)
  p.alpha.set(a)
  ps_opacity(p.wid.v, a)
  p.zoomed_at.set(now_of(p))
}

fn copy_pin(p : Pin) -> Unit {
  let test_to = ui::env("PINSHOT_TEST_COPY")
  if test_to != "" {
    let _ = ps_write_file(cstr(test_to), shown_picture(p))
    return
  }
  hostapi::clipboard_set_image(shown_picture(p))
}

fn save_pin(p : Pin) -> Unit {
  let s = settings.untracked()
  let path = text_of(ps_save_dialog(p.wid.v, cstr(s.save_dir), cstr(file_name())))
  if path != "" {
    write_picture_file(path, shown_picture(p))
  }
}

fn pin_menu(p : Pin) -> Unit {
  let top = p.top.untracked()
  let a = p.alpha.untracked()
  let o = tr("不透明度")
  let ocr_active = p.ocr_on.untracked()
  let ocr_ready = p.ocr.untracked() is Ready(_, _)
  let has_sel = ocr_active && ocr_ready && p.ocr_sel.untracked().is_some()
  let lines : Array[String] = []
  if ocr_active {
    if has_sel {
      lines.push("copy-sel\t" + tr("复制选中文字") + "\t" + key_hint("Ctrl+C"))
      lines.push("copy-all\t" + tr("复制全部文字") + "\t")
    } else if ocr_ready {
      lines.push("copy-all\t" + tr("复制全部文字") + "\t" + key_hint("Ctrl+C"))
    }
    lines.push("ocr-off\t" + tr("退出选字") + "\t" + key_hint("Ctrl+O"))
    lines.push("-")
    lines.push("copy\t" + tr("复制图片") + "\t")
    lines.push("save\t" + tr("另存为…") + "\t")
  } else {
    lines.push("copy\t" + tr("复制") + "\t" + key_hint("Ctrl+C"))
    lines.push("save\t" + tr("另存为…") + "\t")
    lines.push("ocr\t" + tr("提取文字") + "\t" + key_hint("Ctrl+O"))
  }
  for item in [
    "-",
    "top\t" + tr("置顶") + "\t" + (if top { "c" } else { "" }),
    "front\t" + tr("移到最前") + "\t",
    "-",
    "turn-ccw\t" + tr("向左旋转 90°") + "\t" + key_hint("Ctrl+Shift+R"),
    "turn-cw\t" + tr("向右旋转 90°") + "\t" + key_hint("Ctrl+R"),
    "flip-x\t" + tr("水平翻转") + "\t",
    "flip-y\t" + tr("垂直翻转") + "\t",
    "zoom1\t" + tr("原始大小 (100%)") + "\t" + key_hint("Ctrl+0"),
    "reset\t" + tr("重置") + "\t" + (if pin_as_pinned(p) { "g" } else { "" }),
    "-",
    "a100\t\{o} 100%\t" + (if a >= 255 { "c" } else { "" }),
    "a80\t\{o} 80%\t" + (if a == 204 { "c" } else { "" }),
    "a60\t\{o} 60%\t" + (if a == 153 { "c" } else { "" }),
    "a40\t\{o} 40%\t" + (if a == 102 { "c" } else { "" }),
    "-",
    "close\t" + tr("关闭") + "\tEsc",
    "destroy\t" + tr("销毁（不进贴图历史）") + "\t" + key_hint("Ctrl+D"),
    "close-all\t" + tr("关闭全部贴图") + "\t",
  ] {
    lines.push(item)
  }
  let chose = text_of(ps_popup_menu(p.wid.v, utf8_encode(menu_lines(lines))))
  match chose {
    "copy-sel" => { let _ = pin_copy_ocr_selected(p) }
    "copy-all" => { let _ = pin_copy_ocr_all(p) }
    "ocr-off" => pin_exit_ocr(p)
    "copy" => copy_pin(p)
    "save" => save_pin(p)
    "ocr" => pin_start_ocr(p)
    "top" => {
      p.top.set(!top)
      ps_topmost(p.wid.v, if top { 0 } else { 1 }, 0)
    }
    "front" => ps_topmost(p.wid.v, if top { 1 } else { 0 }, 1)
    "turn-ccw" => turn_pin(p, false)
    "turn-cw" => turn_pin(p, true)
    "flip-x" => flip_pin(p, true)
    "flip-y" => flip_pin(p, false)
    "zoom1" => zoom_pin(p, 1.0, 1.0)
    "reset" => reset_pin(p)
    "a100" => set_alpha(p, 255)
    "a80" => set_alpha(p, 204)
    "a60" => set_alpha(p, 153)
    "a40" => set_alpha(p, 102)
    "close" => close_pin(p.wid.v)
    "destroy" => destroy_pin(p)
    "close-all" => {
      let wids : Array[Int] = []
      for k in pins.keys() {
        match pins.get(k) {
          Some(q) => wids.push(q.wid.v)
          None => ()
        }
      }
      shelve_pins(wids)
      for w in wids {
        close_pin(w)
      }
    }
    _ => ()
  }
}

fn key_hint(k : String) -> String {
  if ui::keys_system() == 0 {
    str_replace_all(str_replace_all(k, "Ctrl+Shift+", "⇧⌘"), "Ctrl+", "⌘")
  } else {
    k
  }
}

fn menu_lines(lines : Array[String]) -> String {
  let sb = StringBuilder::new()
  for l in lines {
    if l == "-" {
      sb.write_string("-\n")
      continue
    }
    let parts : Array[String] = l.split("\t")
    let key = parts[0]
    let words = if parts.length() > 1 { parts[1] } else { "" }
    let third = if parts.length() > 2 { parts[2] } else { "" }
    let (hint, flags) = if third == "c" || third == "g" || third == "" { ("", third) } else { (third, "") }
    sb.write_string(key)
    sb.write_char('\t')
    sb.write_string(words)
    if hint != "" {
      sb.write_string("\u{8}" + hint)
    }
    sb.write_char('\t')
    sb.write_string(flags)
    sb.write_char('\n')
  }
  sb.to_string()
}

fn pin_window(wid : Int, what : String) -> (view::View) -> Unit {
  fn(root) {
    let p = match pins.get(what) {
      Some(_v) => _v
      None => { return }
    }
    p.wid.v = wid
    pin_roots[wid] = root
    root.tree.hand_over_presses(false)
    let _ = root
    .ground(view::Live::Is(0x000000FFL))
    .keymap(view::Live::Is(pin_keys()))
    .presses(view::Live::Is(true))
    .cursor(view::Live::By(fn() {
      let e = p.edge.get()
      if e != 0 {
        Some(edge_cursor(e))
      } else if p.ocr_on.get() {
        match p.ocr.get() {
          Ready(ws, _) if ws.length() > 0 => Some(view::Cursor::IBeam)
          _ => Some(view::Cursor::Arrow)
        }
      } else {
        Some(view::Cursor::Arrow)
      }
    }))
    .on_pointer_moved(fn() {
      if p.sizing.v.is_none() {
        if !p.ocr_on.untracked() {
          p.edge.set(pin_edge(p))
        } else {
          let (e, u, v, pw, ph) = pin_pointer_uv(p)
          p.edge.set(e)
          if e != 0 {
            p.ocr_hover.set(-1)
          } else {
            match p.ocr.untracked() {
              Ready(ws, _) => p.ocr_hover.set(ocr_hit_word(ws, u, v, pw, ph))
              _ => p.ocr_hover.set(-1)
            }
          }
        }
      }
    })
    .on_drag(fn(d) {
      match p.sizing.v {
        Some(s) if d.kind != view::DragIs::Down => {
          if d.kind == view::DragIs::Moved {
            size_pin(p, s)
          } else {
            p.sizing.v = None
            p.edge.set(pin_edge(p))
          }
          return
        }
        _ => ()
      }
      if p.ocr_selecting.v && d.kind != view::DragIs::Down {
        match p.ocr.untracked() {
          Ready(ws, _) if ws.length() > 0 => {
            let (_, _, lw, lh) = root.laid_window_now()
            let (u, v) = if lw > 0.0 && lh > 0.0 {
              (clamp(d.x / lw, 0.0, 1.0), clamp(d.y / lh, 0.0, 1.0))
            } else {
              let (_, pu, pv, _, _) = pin_pointer_uv(p)
              (clamp(pu, 0.0, 1.0), clamp(pv, 0.0, 1.0))
            }
            if d.kind == view::DragIs::Moved {
              if !p.ocr_drag_moved.v &&
                 (d.x - p.ocr_down_x.v).abs() + (d.y - p.ocr_down_y.v).abs() >= 3.0 {
                p.ocr_drag_moved.v = true
              }
              if p.ocr_drag_moved.v {
                let focus = ocr_nearest_word(ws, u, v)
                if focus >= 0 {
                  p.ocr_sel.set(Some((p.ocr_anchor.v, focus)))
                }
              }
            } else {
              p.ocr_selecting.v = false
              if !p.ocr_drag_moved.v {
                let idx = p.ocr_anchor.v
                if !p.ocr_down_on_word.v {
                  p.ocr_sel.set(None)
                  p.ocr_clicks.v = 0
                } else if idx >= 0 && idx < ws.length() {
                  let prev_i = p.ocr_click_word.v
                  let same = d.at - p.ocr_click_at.v <= 420.0 &&
                    (prev_i == idx || (prev_i >= 0 && prev_i < ws.length() && ws[prev_i].line == ws[idx].line))
                  let clicks = if same { (p.ocr_clicks.v % 3) + 1 } else { 1 }
                  p.ocr_click_at.v = d.at
                  p.ocr_click_word.v = idx
                  p.ocr_clicks.v = clicks
                  if clicks == 1 {
                    p.ocr_sel.set(None)
                  } else if clicks == 2 {
                    p.ocr_sel.set(Some(ocr_token_range(ws, idx)))
                  } else {
                    p.ocr_sel.set(Some(ocr_line_range(ws, idx)))
                  }
                }
              } else {
                p.ocr_clicks.v = 0
              }
            }
          }
          _ => p.ocr_selecting.v = false
        }
        return
      }
      if d.kind == view::DragIs::Down {
        p.sizing.v = None
        p.ocr_selecting.v = false
        let (e, pu, pv, ppw, pph) = pin_pointer_uv(p)
        p.edge.set(e)
        if e != 0 {
          let r = numbers_of(text_of(ps_window_rect(wid)))
          let q = numbers_of(text_of(ps_pointer()))
          if r.length() >= 4 && q.length() >= 2 {
            p.sizing.v = Some(PinSizing::{
              edge: e,
              x: r[0],
              y: r[1],
              w: r[2],
              h: r[3],
              zx: p.zx.untracked(),
              zy: p.zy.untracked(),
              px: q[0],
              py: q[1],
            })
            return
          }
        }
        if p.ocr_on.untracked() {
          match p.ocr.untracked() {
            Ready(ws, _) if ws.length() > 0 => {
              let (_, _, lw, lh) = root.laid_window_now()
              let (u, v, pw, ph) = if lw > 0.0 && lh > 0.0 {
                (clamp(d.x / lw, 0.0, 1.0), clamp(d.y / lh, 0.0, 1.0), lw, lh)
              } else {
                (pu, pv, ppw, pph)
              }
              let hit = ocr_hit_word(ws, u, v, pw, ph)
              let anchor = if hit >= 0 { hit } else { ocr_nearest_word(ws, u, v) }
              if anchor >= 0 {
                p.ocr_selecting.v = true
                p.ocr_anchor.v = anchor
                p.ocr_down_on_word.v = hit >= 0
                p.ocr_down_x.v = d.x
                p.ocr_down_y.v = d.y
                p.ocr_drag_moved.v = false
                p.ocr_hover.set(hit)
                return
              }
            }
            _ => ()
          }
          p.ocr_sel.set(None)
          p.ocr_clicks.v = 0
        }
        // (moved by the system's own move, the press then let go of as the move ends: mbui hears no release from
        // it, and took the next press for one, every other press not moving the pin)
        ps_move_window(wid)
      }
    }, whole=true)
    .on_menu(fn(_) { pin_menu(p) })
    .on_wheel(fn(w) {
      let notch = if w.dy > 0.0 { 1.0 } else if w.dy < 0.0 { -1.0 } else { 0.0 }
      if notch == 0.0 || p.sizing.v.is_some() {
        return
      }
      if (w.mods & ui::wheel_mod_ctrl) != 0 {
        set_alpha(p, p.alpha.untracked() - (notch * 26.0).to_int())
      } else {
        scale_pin(p, if notch < 0.0 { 1.1 } else { 1.0 / 1.1 })
      }
    })
    let px = clampi(if p.w > p.h { p.w } else { p.h }, 1, 16384)
    let _ = root.box(fn(i) { let _ = i.over(view::Live::Is(true)).image(view::Live::By(fn() { Some((p.key.get(), "", px)) })).presses(view::Live::Is(false)) })
    let _ = root.box(fn(lt) {
      let _ = lt.over(view::Live::Is(true)).presses(view::Live::Is(false)).picture(view::Live::By(fn() { ocr_overlay_picture(p, root.pointed()) }))
    })
    let _ = root.box(fn(e) {
      let _ = e
      .over(view::Live::Is(true))
      .presses(view::Live::Is(false))
      .ground(view::Live::By(fn() {
        let f = pin_flash(e, p)
        if f <= 0.0 {
          0L
        } else {
          0x2F9BFF00L | (f * 70.0).round().to_int64()
        }
      }))
      .edge(view::Live::By(fn() {
        let f = pin_flash(e, p)
        if f > 0.001 {
          (3.0 + 7.0 * f, accent)
        } else if p.active.get() {
          (3.0, accent)
        } else if root.pointed() {
          (2.0, accent)
        } else {
          (1.0, 0x8C919966L)
        }
      }))
    })
    let _ = root.box(fn(o) {
      let _ = o
      .over(view::Live::Is(true))
      .presses(view::Live::Is(false))
      .lines_up(view::Live::Is(Some(view::Along::End)))
      .lies_along(view::Live::Is(view::Lies::End))
      .padding(view::Live::By(fn() { if p.ocr_on.get() { (6.0, 6.0, 6.0, 40.0) } else { (6.0, 6.0, 6.0, 6.0) } }))
      let _ = o.box(fn(l) {
        let _ = l
        .height(view::Live::Is(Some(20.0)))
        .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
        .radius(view::Live::Is(4.0))
        .ground(view::Live::Is(0x17181BD9L))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .laid_nowhere(view::Live::By(fn() { root.drawn_past(p.zoomed_at.get() + 900.0) }))
        let _ = l.box(fn(t) {
          let _ = t
          .words(view::Live::By(fn() {
            let a = p.alpha.get()
            let pc = fn(z : Double) { (z * 100.0).round().to_int() }
            let (zx, zy) = (pc(p.zx.get()), pc(p.zy.get()))
            (if zx == zy { "\{zx}%" } else { "\{zx}% × \{zy}%" }) +
            (if a < 255 { "  ·  \{a * 100 / 255}%" } else { "" })
          }), look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, line: 14.0, wrap: false })
          .ink(view::Live::Is(0xEDEEF0FFL))
        })
      })
    })
    ocr_floating_bar(root, p)
    pin_actions(root, p)
  }
}

fn pin_keys() -> view::Keymap {
  let k = fn(code : Int, action : String, mods : Int) -> view::Binding {
    view::Binding::{ keys: [view::Stroke::{ code, mods }], action, when: view::KeyWhen::Always }
  }
  let ch = fn(c : Char, action : String, mods : Int) { k(ui::key_of_char(c), action, mods) }
  let shift = ui::mod_shift_key
  view::Keymap::new([
    k(ui::key_escape, "close", 0),
    ch('c', "copy", shortcut_mod()),
    k(ui::key_code_copy, "copy", shortcut_mod()),
    ch('a', "select-all", shortcut_mod()),
    k(ui::key_code_select_all, "select-all", shortcut_mod()),
    k(ui::key_code_select_all, "select-all", 0),
    ch('o', "ocr", shortcut_mod()),
    ch('s', "save", shortcut_mod()),
    ch('d', "destroy", shortcut_mod()),
    ch('w', "close-pin", shortcut_mod()),
    ch('t', "top", shortcut_mod()),
    ch('0', "zoom1", shortcut_mod()),
    ch('r', "turn-cw", shortcut_mod()),
    ch('r', "turn-ccw", shortcut_mod() | shift),
    k(ui::key_code_left, "left", 0),
    k(ui::key_code_right, "right", 0),
    k(ui::key_code_up, "up", 0),
    k(ui::key_code_down, "down", 0),
    k(ui::key_code_left, "left10", shift),
    k(ui::key_code_right, "right10", shift),
    k(ui::key_code_up, "up10", shift),
    k(ui::key_code_down, "down10", shift),
  ])
}

fn nudge_pin(p : Pin, dx : Int, dy : Int) -> Unit {
  let r = numbers_of(text_of(ps_window_rect(p.wid.v)))
  if r.length() < 4 {
    return
  }
  ps_place(
    p.wid.v,
    r[0].round().to_int() + dx,
    r[1].round().to_int() + dy,
    r[2].round().to_int(),
    r[3].round().to_int(),
    0,
    0,
  )
}

fn pin_actions(root : view::View, p : Pin) -> Unit {
  let on = fn(name : String, f : () -> Unit) {
    let _ = root.on_action(name, fn(_) {
      f()
      true
    })
  }
  on("close", fn() {
    if p.ocr_on.untracked() && p.ocr_sel.untracked().is_some() {
      p.ocr_sel.set(None)
    } else if p.ocr_on.untracked() && !p.ocr_from_capture.v {
      pin_exit_ocr(p)
    } else {
      close_pin(p.wid.v)
    }
  })
  on("copy", fn() {
    if p.ocr_on.untracked() && p.ocr.untracked() is Ready(_, _) {
      if !pin_copy_ocr_selected(p) {
        let _ = pin_copy_ocr_all(p)
      }
    } else {
      copy_pin(p)
    }
  })
  on("select-all", fn() {
    if p.ocr_on.untracked() {
      match p.ocr.untracked() {
        Ready(ws, _) if ws.length() > 0 => p.ocr_sel.set(Some((0, ws.length() - 1)))
        _ => ()
      }
    }
  })
  on("ocr", fn() { pin_toggle_ocr(p) })
  on("save", fn() { save_pin(p) })
  on("destroy", fn() { destroy_pin(p) })
  on("close-pin", fn() { close_pin(p.wid.v) })
  on("top", fn() {
    let top = !p.top.untracked()
    p.top.set(top)
    ps_topmost(p.wid.v, if top { 1 } else { 0 }, 0)
  })
  on("zoom1", fn() { zoom_pin(p, 1.0, 1.0) })
  on("reset", fn() { reset_pin(p) })
  on("turn-cw", fn() { turn_pin(p, true) })
  on("turn-ccw", fn() { turn_pin(p, false) })
  for step in [(1, ""), (10, "10")] {
    let (n, s) = step
    on("left" + s, fn() { nudge_pin(p, -n, 0) })
    on("right" + s, fn() { nudge_pin(p, n, 0) })
    on("up" + s, fn() { nudge_pin(p, 0, -n) })
    on("down" + s, fn() { nudge_pin(p, 0, n) })
  }
}

fn pin_flash(_n : view::View, p : Pin) -> Double {
  p.flash.get()
}

fn pin_tick(wid : Int) -> Unit {
  guard pin_of_wid(wid) is Some((_, p)) else { return }
  let x = clamp((ps_now_ms() - p.active_at.untracked()) / 360.0, 0.0, 1.0)
  let e = 1.0 - (1.0 - x) * (1.0 - x) * (1.0 - x)
  p.flash.set(1.0 - e)
}

fn pin_active(wid : Int, on : Bool) -> Unit {
  guard pin_of_wid(wid) is Some((_, p)) else { return }
  p.active.set(on)
  if !on {
    return
  }
  p.active_at.set(ps_now_ms())
  p.flash.set(1.0)
  if hostapi::platform() == 0 && pin_roots.get(wid) is Some(root) {
    let since = p.active_at.untracked()
    let advance_ref : signals::Ref[() -> Unit] = signals::ref_new(fn() { () })
    advance_ref.v = fn() {
      if p.active_at.untracked() == since && p.flash.untracked() > 0.0 {
        pin_tick(wid)
        let _ = root.at_moment(root.cause_at() + 16.0, advance_ref.v, later=true)
      }
    }
    (advance_ref.v)()
  }
}
