import "host"
import "hostapi"
import "json"
import "signals"
import "ui"

pub fn main(_world : World) -> Int {
  host::install()
  if handle_install_cli() {
    return 0
  }
  let args = text_of(ps_args()).split("\n")
  if args.length() > 0 && args[0] == "--bench" {
    bench()
    ps_quit()
    return 0
  }
  if args.length() > 1 && args[0] == "--ocr" {
    println(text_of(ps_ocr_now(ps_read_file(cstr(args[1])))))
    ps_quit()
    return 0
  }
  let again = if args.length() > 0 && args[0] == "--settings" {
    1
  } else if args.length() > 0 && args[0] == "--quit" {
    2
  } else if args.length() > 0 && (args[0] == "--updated" || args[0] == "--installed" || args[0] == "--start") {
    3
  } else {
    0
  }
  if ps_start(again) == 0 || again == 2 {
    return 0
  }
  load_settings()
  let updated = args.length() > 0 && args[0] == "--updated"
  let installed = args.length() > 0 && args[0] == "--installed"
  log("started \{app_version}: icon \{if ps_tray_on() == 1 { "shown" } else { "not shown" }}")
  ui::on_message_said("ps", fn(json, bytes) {
    told(json, bytes)
    true
  })
  ui::set_window_tree(fn(wid, what) {
    let build = if what == "settings" {
      settings_window
    } else if what == "welcome" {
      welcome_window
    } else if what == "toast" {
      toast_window
    } else if what == "long" {
      long_window
    } else if what == "rec" {
      rec_window
    } else if what == "rec_fps" {
      rec_fps_window
    } else {
      pin_window(wid, what)
    }
    fn(root) {
      ui::set_tree_theme(app_theme)
      build(root)
    }
  })
  ui::when_window_closed(fn(wid) {
    if wid == settings_wid.v {
      settings_wid.v = 0
      if recording.untracked() != 0 {
        stop_recording()
        apply_keys()
      }
      trim_soon()
    }
    if wid == welcome_wid.v {
      welcome_wid.v = 0
      trim_soon()
    }
    if wid == toast_wid.v {
      toast_wid.v = 0
    }
    if wid == long_wid.v {
      long_gone()
    }
    if wid == rec_wid.v {
      rec_gone()
    }
    if wid == rec_fps_wid.v {
      rec_fps_wid.v = 0
      rec_fps_open.set(false)
    }
    pin_gone(wid)
  })
  apply_keys()
  start_updates(updated, installed=installed)
  hostapi::window_hold()
  hostapi::window_setup(100.0, 100.0, 320.0, 200.0, inset=false)
  if again == 1 {
    started_with_settings.v = true
  } else if installed || (ui::env("PINSHOT_TEST") != "" && ui::env("PINSHOT_TEST_WELCOME") != "") {
    started_with_welcome.v = true
  }
  let _ = ui::on_before_frame(fn() {
    overlay_first_frame()
  })
  ui::run("PinShot", overlay_window, theme=app_theme)
  0
}

fn told(json : String, bytes : Option[Bytes]) -> Unit {
  let o = match json_of(json) {
    Some(json::Json::Object(o)) => o
    _ => return
  }
  let what = jstr(o, "do", "")
  match what {
    "prepare" => {
      let n = fn(k : String) { jnum(o, k, 0.0) }
      asked_at.v = n("t")
      prepare_capture(
        n("x").to_int(),
        n("y").to_int(),
        n("w").to_int(),
        n("h").to_int(),
        n("dpi"),
        wx=n("wx").to_int(),
        wy=n("wy").to_int(),
        ww=n("ww").to_int(),
        wh=n("wh").to_int(),
      )
    }
    "capture" =>
      if capturing.untracked() {
        capture_taken()
      } else {
        ps_capture_release()
      }
    "capture-failed" => toast(tr("截图失败，请重试。"))
    "pin-clipboard" => pin_clipboard()
    "ocr" => ocr_told(o, bytes)
    "http" => http_told(o, bytes)
    "tr-words" => tr_words_told(o, bytes)
    "tr-pic" => tr_pic_told(o, bytes)
    "long" => {
      let n = fn(k : String) { jnum(o, k, 0.0).to_int() }
      long_told(
        n("h"),
        n("lost") != 0,
        n("full") != 0,
        n("paused") != 0,
        n("pics"),
        n("dir"),
        n("at"),
        n("top"),
      )
    }
    "long-png" => {
      let n = fn(k : String) { jnum(o, k, 0.0).to_int() }
      long_png_told(n("id"), n("w"), n("h"), n("ok") != 0, bytes)
    }
    "rec" => {
      let n = fn(k : String) { jnum(o, k, 0.0) }
      let s = fn(k : String) { jstr(o, k, "") }
      rec_told(
        s("state"),
        n("ms").to_int(),
        n("frames").to_int(),
        n("bytes"),
        n("orig"),
        n("pct").to_int(),
        n("audio").to_int(),
        s("codec"),
        s("path"),
        s("err"),
      )
    }
    "rec-av1" => {
      let v = jnum(o, "on", -1.0)
      if v >= 0.0 { rec_av1_told(v.to_int()) }
    }
    "rec-rect" => {
      let n = fn(k : String) { jnum(o, k, 0.0).to_int() }
      rec_rect_told(n("x"), n("y"), n("w"), n("h"))
    }
    "tick" => {
      let w = jnum(o, "wid", -1.0)
      if w >= 0.0 { pin_tick(w.to_int()) }
    }
    "active" => {
      let w = jnum(o, "wid", -1.0)
      if w >= 0.0 {
        let wid = w.to_int()
        let on = jnum(o, "on", 0.0) != 0.0
        let other = jnum(o, "other", 0.0).to_int()
        pin_active(wid, on)
        rec_active(wid, on, other)
      }
    }
    "pins" => pins_toggle()
    "key-pressed" => {
      let n = fn(k : String) { jnum(o, k, 0.0).to_int() }
      let how = jstr(o, "how", "cancel")
      key_pressed(how, n("mods"), n("vk"))
    }
    "fetching" | "fetched" | "setup-ended" => update_told(what, o, bytes)
    "update-tick" => update_tick()
    "close" => {
      let w = jnum(o, "wid", -1.0)
      if w >= 0.0 {
        let wid = w.to_int()
        if wid == 0 {
          close_capture()
        } else if wid == settings_wid.v {
          close_window(wid)
        } else if wid == long_wid.v {
          long_close()
        } else if wid == rec_wid.v {
          rec_cancel()
        } else if wid == rec_fps_wid.v {
          rec_fps_open.set(false)
        } else {
          close_pin(wid)
        }
      }
    }
    "menu" =>
      match jstr(o, "item", "") {
        "capture" => ps_capture_ask()
        "pin-clip" => pin_clipboard()
        "pins" => pins_toggle()
        "settings" => open_settings()
        "folder" => ps_reveal(cstr(settings.untracked().save_dir))
        "check-update" => {
          open_settings(tab=4)
          check_update(true)
        }
        "quit" => ps_quit()
        _ => ()
      }
    _ => ()
  }
}

fn bench() -> Unit {
  let times : Array[Double] = []
  for _ in 0..<10 {
    let t0 = ps_now_ms()
    let _ = ps_capture_now()
    let b = ps_capture_take()
    times.push(ps_now_ms() - t0)
    println("bench: \{text_of(ps_capture_info())}")
    let _ = b
    ps_capture_release()
  }
  let _ = ps_capture_now()
  let t1 = ps_now_ms()
  let mut n = 0
  for _ in 0..<10 {
    n = parse_windows(text_of(ps_windows())).length()
  }
  let wins = (ps_now_ms() - t1) / 10.0
  println("bench: screen \{text_of(ps_capture_info())}")
  let sb = StringBuilder::new()
  for i, t in times {
    if i > 0 { sb.write_string(", ") }
    sb.write_string(num(t))
  }
  println("bench: take+hand over (ms): " + sb.to_string())
  println("bench: windows listed: \{n} in \{num(wins)} ms")
  println("bench: memory ws,private: \{text_of(ps_memory())}")
}

let started_with_settings : signals::Ref[Bool] = signals::ref_new(false)

let started_with_welcome : signals::Ref[Bool] = signals::ref_new(false)

let app_theme : () -> ui::Theme = fn() { theme_kept }

let theme_kept : ui::Theme = ui::Theme::{ ..ui::Theme::dark(), bg: 0x000000FFL, tabular: true }

let app_version : String = "1.0.38"
