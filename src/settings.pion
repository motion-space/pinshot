import "hostapi"
import "json"
import "motion"
import "signals"
import "ui"
import "view"

#derive(Eq)
struct Settings {
  capture_key : Hotkey
  pin_key : Hotkey
  confirm_key : Hotkey
  pin_top : Bool
  pin_alpha : Int
  save_format : Int
  ask_where : Bool
  save_dir : String
  keep_copies : Bool
  capture_keep : Bool
  language : Int
  sound : Bool
  auto_update : Bool
  tr_provider : String
  tr_key_deepseek : String
  tr_key_openai : String
  tr_base : String
  tr_model_deepseek : String
  tr_model_openai : String
}

let key_choices : Array[(String, Int, Int)] = if hostapi::platform() == 0 {
  [("⌃⌥A", 3, 0x41), ("⌃1", 2, 0x31), ("F1", 0, 0x70), ("⌃⇧A", 6, 0x41)]
} else {
  [("Ctrl+Alt+A", 3, 0x41), ("Ctrl+1", 2, 0x31), ("F1", 0, 0x70),
   ("Ctrl+Shift+A", 6, 0x41), ("PrtSc", 0, 0x2C)]
}

let pin_choices : Array[(String, Int, Int)] = [
  (if hostapi::platform() == 0 { "⌃2" } else { "Ctrl+2" }, 2, 0x32),
  ("F3", 0, 0x72),
  ("F2", 0, 0x71),
  ("不用快捷键", 0, 0),
]

let confirm_choices : Array[(String, Int, Int)] = if hostapi::platform() == 0 {
  [("不用快捷键", 0, 0), ("Space", 0, 0x20), ("Tab", 0, 0x09), ("⌘Return", 8, 0x0D)]
} else {
  [("不用快捷键", 0, 0), ("Space", 0, 0x20), ("Tab", 0, 0x09), ("Ctrl+Enter", 2, 0x0D)]
}

fn confirm_key_label() -> String {
  let h = settings.get().confirm_key
  if h.vk == 0 {
    if hostapi::platform() == 0 { "Return" } else { "Enter" }
  } else {
    key_words(h, confirm_choices)
  }
}

#derive(Eq)
struct Hotkey {
  mods : Int
  vk : Int
}

fn hotkey_of(c : (String, Int, Int)) -> Hotkey {
  Hotkey::{ mods: c.1, vk: c.2 }
}

fn keys_pressed_in() -> Bool {
  hostapi::platform() == 3 || hostapi::platform() == 0
}

fn key_words(h : Hotkey, choices : Array[(String, Int, Int)]) -> String {
  if h.vk == 0 {
    return tr("未设置")
  }
  for c in choices {
    if c.1 == h.mods && c.2 == h.vk {
      return tr(c.0)
    }
  }
  if hostapi::platform() == 0 {
    let sb = StringBuilder::new()
    if (h.mods & 2) != 0 {
      sb.write_string("⌃")
    }
    if (h.mods & 1) != 0 {
      sb.write_string("⌥")
    }
    if (h.mods & 4) != 0 {
      sb.write_string("⇧")
    }
    if (h.mods & 8) != 0 {
      sb.write_string("⌘")
    }
    sb.write_string(text_of(ps_key_name(h.vk)))
    return sb.to_string()
  }
  let parts : Array[String] = []
  if (h.mods & 2) != 0 {
    parts.push("Ctrl")
  }
  if (h.mods & 1) != 0 {
    parts.push("Alt")
  }
  if (h.mods & 4) != 0 {
    parts.push("Shift")
  }
  if (h.mods & 8) != 0 {
    parts.push("Win")
  }
  parts.push(text_of(ps_key_name(h.vk)))
  parts.join("+")
}

fn choice_named(choices : Array[(String, Int, Int)], name : String) -> Int {
  for i, c in choices {
    if c.0 == name {
      return i
    }
  }
  0
}

fn default_settings() -> Settings {
  Settings::{
    capture_key: hotkey_of(key_choices[0]),
    pin_key: hotkey_of(pin_choices[0]),
    confirm_key: hotkey_of(confirm_choices[0]),
    pin_top: true,
    pin_alpha: 255,
    save_format: 0,
    ask_where: true,
    save_dir: text_of(ps_pictures_dir()),
    keep_copies: false,
    capture_keep: true,
    sound: true,
    language: 0,
    auto_update: false,
    tr_provider: "google",
    tr_key_deepseek: "",
    tr_key_openai: "",
    tr_base: "",
    tr_model_deepseek: "",
    tr_model_openai: "",
  }
}

let settings : signals::Signal[Settings] = signals::signal_by(Settings::{
  capture_key: hotkey_of(key_choices[0]),
  pin_key: hotkey_of(pin_choices[0]),
  confirm_key: hotkey_of(confirm_choices[0]),
  pin_top: true,
  pin_alpha: 255,
  save_format: 0,
  ask_where: true,
  save_dir: "",
  keep_copies: false,
  capture_keep: true,
  sound: true,
  language: 0,
  auto_update: false,
  tr_provider: "google",
  tr_key_deepseek: "",
  tr_key_openai: "",
  tr_base: "",
  tr_model_deepseek: "",
  tr_model_openai: "",
}, same=fn(a, b) { a == b })

let capture_key_ok : signals::Signal[Bool] = signals::signal(true)

let pin_key_ok : signals::Signal[Bool] = signals::signal(true)

let autostart : signals::Signal[Bool] = signals::signal(false)

fn settings_path() -> String {
  file_in(text_of(ps_data_dir()), "settings.json")
}

fn init_key_choices() -> Unit {
  key_choices.clear()
  pin_choices.clear()
  confirm_choices.clear()
  if hostapi::platform() == 0 {
    for c in [("⌃⌥A", 3, 0x41), ("⌃1", 2, 0x31), ("F1", 0, 0x70), ("⌃⇧A", 6, 0x41)] {
      key_choices.push(c)
    }
    for c in [("⌃2", 2, 0x32), ("F3", 0, 0x72), ("F2", 0, 0x71), ("不用快捷键", 0, 0)] {
      pin_choices.push(c)
    }
    for c in [("不用快捷键", 0, 0), ("Space", 0, 0x20), ("Tab", 0, 0x09), ("⌘Return", 8, 0x0D)] {
      confirm_choices.push(c)
    }
  } else {
    for c in [("Ctrl+Alt+A", 3, 0x41), ("Ctrl+1", 2, 0x31), ("F1", 0, 0x70), ("Ctrl+Shift+A", 6, 0x41), ("PrtSc", 0, 0x2C)] {
      key_choices.push(c)
    }
    for c in [("Ctrl+2", 2, 0x32), ("F3", 0, 0x72), ("F2", 0, 0x71), ("不用快捷键", 0, 0)] {
      pin_choices.push(c)
    }
    for c in [("不用快捷键", 0, 0), ("Space", 0, 0x20), ("Tab", 0, 0x09), ("Ctrl+Enter", 2, 0x0D)] {
      confirm_choices.push(c)
    }
  }
}

fn load_settings() -> Unit {
  init_key_choices()
  let d = default_settings()
  let read = json_of(text_of(ps_read_file(cstr(settings_path()))))
  let s = match read {
    Some(json::Json::Object(o)) => {
      let num = fn(name : String, dflt : Int) { jnum(o, name, dflt.to_double()).to_int() }
      let flag = fn(name : String, dflt : Bool) { jbool(o, name, dflt) }
      let text = fn(name : String, dflt : String) {
        let v = jstr(o, name, "")
        if v != "" { v } else { dflt }
      }
      let hotkey = fn(name : String, older : String, choices : Array[(String, Int, Int)]) -> Hotkey {
        match o.get(name) {
          Some(json::Json::Object(k)) => {
            let m = jnum(k, "mods", -1.0)
            let v = jnum(k, "vk", -1.0)
            if m >= 0.0 && v >= 0.0 {
              Hotkey::{ mods: m.to_int() & 15, vk: v.to_int() & 255 }
            } else {
              hotkey_of(choices[0])
            }
          }
          _ => hotkey_of(choices[choice_named(choices, text(older, choices[0].0))])
        }
      }
      Settings::{
        capture_key: hotkey("capture_key", "capture_keys", key_choices),
        pin_key: hotkey("pin_key", "pin_keys", pin_choices),
        confirm_key: hotkey("confirm_key", "confirm_keys", confirm_choices),
        pin_top: flag("pin_top", d.pin_top),
        pin_alpha: clampi(num("pin_alpha", d.pin_alpha), 25, 255),
        save_format: match text("save_format", "png") {
          "jpg-92" => 1
          "jpg-80" => 2
          _ => 0
        },
        ask_where: flag("ask_where", d.ask_where),
        save_dir: text("save_dir", d.save_dir),
        keep_copies: flag("keep_copies", d.keep_copies),
        capture_keep: flag("capture_keep", d.capture_keep),
        sound: flag("sound", d.sound),
        auto_update: flag("auto_update", d.auto_update),
        language: match text("language", "system") {
          "zh" => 1
          "en" => 2
          _ => 0
        },
        tr_provider: match text("tr_provider", "google") {
          "deepseek" => "deepseek"
          "openai" => "openai"
          _ => "google"
        },
        tr_key_deepseek: jstr(o, "tr_key_deepseek", ""),
        tr_key_openai: jstr(o, "tr_key_openai", ""),
        tr_base: jstr(o, "tr_base", ""),
        tr_model_deepseek: jstr(o, "tr_model_deepseek", ""),
        tr_model_openai: jstr(o, "tr_model_openai", ""),
      }
    }
    _ => d
  }
  match read {
    Some(json::Json::Object(o)) => {
      let rnum = fn(name : String, dflt : Int) { jnum(o, name, dflt.to_double()).to_int() }
      let rflag = fn(name : String, dflt : Bool) { jbool(o, name, dflt) }
      let rf = rnum("rec_fps", 60)
      rec_fps.set(if rf == 30 || rf == 60 || rf == 90 || rf == 120 { rf } else { 60 })
      rec_cursor.set(rflag("rec_cursor", true))
      rec_audio.set(rflag("rec_audio", false))
      rec_input.set(rflag("rec_input", false))
      rec_exp_fmt.set(clampi(rnum("rec_exp_fmt", 0), 0, 3))
      rec_exp_qual.set(clampi(rnum("rec_exp_qual", 2), 0, 3))
      let rs = rnum("rec_exp_scale", 0)
      rec_exp_scale.set(if rs == 75 || rs == 50 { rs } else { 0 })
      let rgs = rnum("rec_exp_gif_scale", 1080)
      rec_exp_gif_scale.set(if rgs == 0 || rgs == 720 { rgs } else { 1080 })
      let rg = rnum("rec_exp_gif_fps", 15)
      rec_exp_gif_fps.set(if rg == 10 || rg == 20 { rg } else { 15 })
    }
    _ => ()
  }
  settings.set(s)
  apply_language(s.language)
  ps_set_capture_keep(if s.capture_keep { 1 } else { 0 })
  autostart.set(ps_autostart() == 1)
}

fn save_settings() -> Unit {
  let s = settings.untracked()
  let o : Map[String, json::Json] = Map::new()
  let hotkey = fn(h : Hotkey) {
    let k : Map[String, json::Json] = Map::new()
    k["mods"] = json_num(h.mods.to_double())
    k["vk"] = json_num(h.vk.to_double())
    json_obj_map(k)
  }
  o["capture_key"] = hotkey(s.capture_key)
  o["pin_key"] = hotkey(s.pin_key)
  o["confirm_key"] = hotkey(s.confirm_key)
  o["pin_top"] = json_bool(s.pin_top)
  o["pin_alpha"] = json_num(s.pin_alpha.to_double())
  o["save_format"] = json_str(["png", "jpg-92", "jpg-80"][s.save_format])
  o["ask_where"] = json_bool(s.ask_where)
  o["save_dir"] = json_str(s.save_dir)
  o["keep_copies"] = json_bool(s.keep_copies)
  o["capture_keep"] = json_bool(s.capture_keep)
  o["sound"] = json_bool(s.sound)
  o["auto_update"] = json_bool(s.auto_update)
  o["language"] = json_str(["system", "zh", "en"][s.language])
  o["tr_provider"] = json_str(s.tr_provider)
  o["tr_key_deepseek"] = json_str(s.tr_key_deepseek)
  o["tr_key_openai"] = json_str(s.tr_key_openai)
  o["tr_base"] = json_str(s.tr_base)
  o["tr_model_deepseek"] = json_str(s.tr_model_deepseek)
  o["tr_model_openai"] = json_str(s.tr_model_openai)
  o["rec_fps"] = json_num(rec_fps.untracked().to_double())
  o["rec_cursor"] = json_bool(rec_cursor.untracked())
  o["rec_audio"] = json_bool(rec_audio.untracked())
  o["rec_input"] = json_bool(rec_input.untracked())
  o["rec_exp_fmt"] = json_num(rec_exp_fmt.untracked().to_double())
  o["rec_exp_qual"] = json_num(rec_exp_qual.untracked().to_double())
  o["rec_exp_scale"] = json_num(rec_exp_scale.untracked().to_double())
  o["rec_exp_gif_scale"] = json_num(rec_exp_gif_scale.untracked().to_double())
  o["rec_exp_gif_fps"] = json_num(rec_exp_gif_fps.untracked().to_double())
  let _ = ps_write_file(cstr(settings_path()), utf8_encode(json_stringify(json_obj_map(o))))
}

fn change_settings(f : (Settings) -> Settings) -> Unit {
  let was = settings.untracked()
  let s = f(was)
  if s == was {
    return
  }
  settings.set(s)
  save_settings()
  if s.capture_keep != was.capture_keep {
    ps_set_capture_keep(if s.capture_keep { 1 } else { 0 })
  }
  if s.language != was.language {
    apply_language(s.language)
  }
  if s.capture_key != was.capture_key || s.pin_key != was.pin_key || s.language != was.language {
    apply_keys()
  }
}

fn apply_keys() -> Unit {
  let s = settings.untracked()
  let cw = key_words(s.capture_key, key_choices)
  let pw = key_words(s.pin_key, pin_choices)
  let pv = s.pin_key.vk
  capture_key_ok.set(ps_hotkey(1, s.capture_key.mods, s.capture_key.vk) == 1)
  pin_key_ok.set(ps_hotkey(2, s.pin_key.mods, pv) == 1)
  log("keys: capture \{cw} \{if capture_key_ok.untracked() { "ok" } else { "taken by another program" }}, pin \{pw} \{if pin_key_ok.untracked() { "ok" } else { "taken by another program" }}")
  if !capture_key_ok.untracked() {
    ps_tray_note(
      cstr(tr("截图快捷键被其他程序占用：") + cw),
      cstr(tr("点这里打开 PinShot 设置换一个；或者退出占用它的程序（比如 PixPin）后重新打开 PinShot。")),
    )
  }
  let pin_words = if pv == 0 { tr("贴图剪贴板中的图片") } else { tr("贴图剪贴板中的图片") + "\u{8}" + pw }
  let capture_words = if s.capture_key.vk == 0 { tr("截图") } else { tr("截图") + "\u{8}" + cw }
  let menu = "capture\t" +
    capture_words +
    "\npin-clip\t" +
    pin_words +
    "\npins\t" +
    tr("显示/隐藏全部贴图") +
    "\n-\nsettings\t" +
    tr("设置…") +
    "\nfolder\t" +
    tr("打开截图文件夹") +
    (if updates_here() { "\ncheck-update\t" + tr("检查更新…") } else { "" }) +
    "\n-\nquit\t" +
    tr("退出 PinShot") +
    "\n"
  ps_set_menu(utf8_encode(menu))
}

let settings_wid : signals::Ref[Int] = signals::ref_new(0)

fn open_settings(tab~ : Int = -1) -> Unit {
  if tab >= 0 && tab < settings_tabs.length() {
    settings_tab.set(tab)
  }
  if settings_wid.v > 0 && ui::window_front_here(settings_wid.v) {
    return
  }
  if ui::env("PINSHOT_TEST") != "" {
    match ui::env("PINSHOT_TEST_SETTINGS_TAB") {
      "0" => settings_tab.set(0)
      "1" => settings_tab.set(1)
      "2" => settings_tab.set(2)
      "3" => settings_tab.set(3)
      "4" => settings_tab.set(4)
      _ => ()
    }
  }
  let wid = ui::window_open_here("settings")
  if wid <= 0 {
    return
  }
  settings_wid.v = wid
  ps_center(wid, 680, 450)
}

let recording : signals::Signal[Int] = signals::signal(0)

let key_trouble : signals::Signal[(Int, String)] = signals::signal_by((0, ""), same=fn(a, b) { a.0 == b.0 && a.1 == b.1 })

fn record_key(which : Int) -> Unit {
  let was = recording.untracked()
  stop_recording()
  key_trouble.set((0, ""))
  if was == which {
    apply_keys()
    return
  }
  let _ = ps_hotkey(1, 0, 0)
  let _ = ps_hotkey(2, 0, 0)
  if ps_key_record(1) == 1 {
    recording.set(which)
  } else {
    apply_keys()
  }
}

fn clear_key(which : Int) -> Unit {
  stop_recording()
  key_trouble.set((0, ""))
  let before = settings.untracked()
  if which == 1 {
    change_settings(fn(s) { Settings::{ ..s, capture_key: Hotkey::{ mods: 0, vk: 0 } } })
  } else if which == 2 {
    change_settings(fn(s) { Settings::{ ..s, pin_key: Hotkey::{ mods: 0, vk: 0 } } })
  } else {
    change_settings(fn(s) { Settings::{ ..s, confirm_key: Hotkey::{ mods: 0, vk: 0 } } })
  }
  keys_set_again(before)
}

fn keys_set_again(before : Settings) -> Unit {
  let s = settings.untracked()
  if s.capture_key == before.capture_key && s.pin_key == before.pin_key && s.language == before.language {
    apply_keys()
  }
}

fn stop_recording() -> Unit {
  if recording.untracked() != 0 {
    let _ = ps_key_record(0)
    recording.set(0)
  }
}

fn key_pressed(how : String, mods : Int, vk : Int) -> Unit {
  let which = recording.untracked()
  recording.set(0)
  if which == 0 {
    return
  }
  let was = settings.untracked()
  let trouble = fn(why : String) {
    key_trouble.set((which, why))
    apply_keys()
  }
  match how {
    "cancel" => {
      apply_keys()
      return
    }
    "clear" => {
      clear_key(which)
      return
    }
    _ => ()
  }
  let h : Hotkey = Hotkey::{ mods, vk }
  if which == 3 {
    if hotkey_to_mbui(h).is_none() {
      trouble(tr("暂不支持这个按键，换 Enter、Space、字母、数字或 F1–F12"))
      return
    }
    log("keys: confirm set to \{key_words(h, confirm_choices)}")
    change_settings(fn(s) { Settings::{ ..s, confirm_key: h } })
    apply_keys()
    return
  }
  let alone = (vk >= 0x70 && vk <= 0x87) || vk == 0x2C || vk == 0x13 || vk == 0x91
  if (mods & 11) == 0 && !alone {
    trouble(
      if hostapi::platform() == 0 {
        tr("要和 Command、Control 或 Option 一起按（F1–F24 可以单独用）")
      } else {
        tr("要和 Ctrl、Alt 或 Win 一起按（F1–F24、PrtSc 可以单独用）")
      },
    )
    return
  }
  let other = if which == 1 { was.pin_key } else { was.capture_key }
  if other == h {
    trouble(if which == 1 { tr("和「贴剪贴板图片」的快捷键相同") } else { tr("和「截图」的快捷键相同") })
    return
  }
  if ps_hotkey(which, mods, vk) != 1 {
    trouble(key_words(h, []) + tr(" 已被其他程序占用，换一个"))
    return
  }
  log("keys: \{if which == 1 { "capture" } else { "pin" }} set to \{key_words(h, [])}")
  if which == 1 {
    change_settings(fn(s) { Settings::{ ..s, capture_key: h } })
  } else {
    change_settings(fn(s) { Settings::{ ..s, pin_key: h } })
  }
  keys_set_again(was)
}

let set_ink : Int64 = 0xF5F6F8FFL

let set_muted : Int64 = 0xB2B7C2FFL

let set_ground : Int64 = 0x141518FFL

let set_card : Int64 = 0x222429FFL

let settings_tab : signals::Signal[Int] = signals::signal(0)

let settings_tabs : Array[String] = ["常规", "快捷键", "截图与贴图", "翻译", "关于"]

fn settings_window(root : view::View) -> Unit {
  root.tree.hand_over_presses(false)
  let ctrl = shortcut_mod()
  let k = fn(code : Int, action : String, mods : Int) -> view::Binding {
    view::Binding::{ keys: [view::Stroke::{ code, mods }], action, when: view::KeyWhen::Always }
  }
  let _ = root.keymap(
    view::Live::Is(
      view::Keymap::new([
        k(ui::key_escape, "close", 0),
        k(ui::key_code_up, "tab-prev", 0),
        k(ui::key_code_down, "tab-next", 0),
        k(ui::key_of_char('1'), "tab-0", ctrl),
        k(ui::key_of_char('2'), "tab-1", ctrl),
        k(ui::key_of_char('3'), "tab-2", ctrl),
        k(ui::key_of_char('4'), "tab-3", ctrl),
        k(ui::key_of_char('5'), "tab-4", ctrl),
      ]),
    ),
  )
  let _ = root.on_action("close", fn(_) {
    if recording.untracked() != 0 {
      return false
    }
    if settings_wid.v > 0 {
      close_window(settings_wid.v)
    }
    true
  })
  let _ = root.on_action("tab-prev", fn(_) {
    if recording.untracked() != 0 {
      return false
    }
    settings_tab.set((settings_tab.untracked() + settings_tabs.length() - 1) % settings_tabs.length())
    true
  })
  let _ = root.on_action("tab-next", fn(_) {
    if recording.untracked() != 0 {
      return false
    }
    settings_tab.set((settings_tab.untracked() + 1) % settings_tabs.length())
    true
  })
  for i in 0..<settings_tabs.length() {
    let _ = root.on_action("tab-\{i}", fn(_) {
      if recording.untracked() != 0 {
        return false
      }
      settings_tab.set(i)
      true
    })
  }
  let _ = root.box(fn(w) {
    let _ = w.over(view::Live::Is(true)).ground(view::Live::Is(set_ground)).row(view::Live::Is(true))
    let _ = w.box(fn(side) {
      let _ = side.width(view::Live::Is(Some(168.0))).shrink(view::Live::Is(0.0)).padding(view::Live::Is((12.0, 16.0, 12.0, 16.0))).gap(view::Live::Is(2.0))
      let tab_views : Map[Int, view::View] = Map::new()
      sliding_thumb(
        side,
        fn() { settings_tab.get() },
        tab_views,
        7.0,
        fn() { 0x2B2E36FFL },
        extra_watch=fn() { if english.get() { 1 } else { 0 } },
      )
      for i, name in settings_tabs {
        let _ = side.box(fn(t) {
          tab_views[i] = t
          let hov = smooth_hover(t)
          let act = motion::eased_on(t, fn() { settings_tab.get() == i }, motion_tween(130.0))
          tactile_press(t, sink_px=0.9)
          hig_focus(t)
          let _ = t
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(34.0)))
          .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
          .radius(view::Live::Is(7.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .presses(view::Live::Is(true))
          .cursor(view::Live::Is(Some(view::Cursor::Hand)))
          .says(view::Live::By(fn() { Some(view::said(view::Role::Radio, label=tr(name), selected=settings_tab.get() == i)) }))
          .on_press(fn() { settings_tab.set(i) })
          .ground(view::Live::By(fn() {
            if settings_tab.get() == i {
              0L
            } else {
              mix_rgba(0L, 0xFFFFFF0FL, hov())
            }
          }))
          let _ = t.box(fn(x) {
            let _ = x
            .words(view::Live::By(fn() { tr(name) }), look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, line: 18.0, wrap: false })
            .ink(view::Live::By(fn() { mix_rgba(set_muted, set_ink, dmax(act.shown(x), hov() * 0.45)) }))
          })
        })
      }
    })
    let _ = w.box(fn(line) { let _ = line.width(view::Live::Is(Some(1.0))).shrink(view::Live::Is(0.0)).ground(view::Live::Is(0xFFFFFF1FL)) })
    let _ = w.box(fn(main) {
      let _ = main.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0)))
      let _ = main.box(fn(viewport) {
        let _ = viewport.over(view::Live::Is(true)).scrolls(view::Scroll::new(), fn(page) {
          let _ = page.padding(view::Live::Is((22.0, 18.0, 22.0, 20.0)))
          let pages : Array[(view::View) -> Unit] = [general_page, keys_page, capture_page, translate_page, about_page]
          for i, make in pages {
            let _ = page.box(fn(p) {
              let page_in = motion::NodeWay::new(if settings_tab.untracked() == i { 1.0 } else { 0.0 })
              p.reacts(fn() { settings_tab.get() == i }, at_start=false, fn(on) {
                if on {
                  if reduce_motion() {
                    page_in.put(1.0)
                  } else {
                    page_in.go_from(p, 0.0, 1.0, motion::tween(140.0, ease=ui::Ease::Out))
                  }
                } else {
                  page_in.put(0.0)
                }
              })
              let _ = p
              .laid_nowhere(view::Live::By(fn() { settings_tab.get() != i }))
              .alpha(view::Live::By(fn() { page_in.shown(p) }))
              .drawn_off(view::Live::By(fn() { (0.0, 5.0 * (1.0 - page_in.shown(p))) }))
              .gap(view::Live::Is(12.0))
              set_words(p, fn() { tr(settings_tabs[i]) }, 16.0, set_ink, weight=600)
              make(p)
            })
          }
        })
      })
    })
  })
}

fn general_page(p : view::View) -> Unit {
  set_group(p, "", fn(g) {
    set_row(g, "语言", fn(r) {
      choice(r, language_names, fn() { settings.get().language }, fn(i) {
        change_settings(fn(s) { Settings::{ ..s, language: i } })
      })
    })
    set_row(g, "开机时启动", fn(r) {
      switch(r, fn() { autostart.get() }, fn(on) {
        if ps_set_autostart(if on { 1 } else { 0 }) == 1 {
          autostart.set(on)
        }
      })
    })
    set_row(g, "快门音效", fn(r) {
      switch(r, fn() { settings.get().sound }, fn(on) {
        change_settings(fn(s) { Settings::{ ..s, sound: on } })
        if on {
          ps_shutter()
        }
      })
    }, note=fn() { tr("复制、保存、贴图时播放") }, note_ink=fn() { set_muted })
    if hostapi::platform() == 3 {
      set_row(
        g,
        "截屏模式",
        fn(r) {
          choice(r, ["极速常驻", "按需省显存"], fn() { if settings.get().capture_keep { 0 } else { 1 } }, fn(i) {
            change_settings(fn(s) { Settings::{ ..s, capture_keep: i == 0 } })
          })
        },
        note=fn() {
          if settings.get().capture_keep {
            tr("后台保持截屏会话，按键秒开")
          } else {
            tr("平时不占截屏显存（省约 240 MB），按键时拉起")
          }
        },
        note_ink=fn() { set_muted },
      )
    }
  })
}

fn keys_page(p : view::View) -> Unit {
  set_group(p, "", fn(g) {
    if keys_pressed_in() {
      set_row(g, "截图", fn(r) {
        key_box(r, 1)
      }, note=fn() { key_note(1) })
      set_row(g, "贴剪贴板图片", fn(r) {
        key_box(r, 2)
      }, note=fn() { key_note(2) })
      set_row(g, "额外确认并复制", fn(r) {
        key_box(r, 3)
      }, note=fn() { key_note(3) }, note_ink=fn() { if key_trouble.get().0 == 3 { 0xF5A524FFL } else { set_muted } })
    } else {
      let choice_labels = fn(cs : Array[(String, Int, Int)]) -> Array[String] {
        let out : Array[String] = []
        for c in cs { out.push(c.0) }
        out
      }
      set_row(g, "截图", fn(r) {
        choice(
          r,
          choice_labels(key_choices),
          fn() { choice_of(key_choices, settings.get().capture_key) },
          fn(i) { change_settings(fn(s) { Settings::{ ..s, capture_key: hotkey_of(key_choices[i]) } }) },
        )
      }, note=fn() { key_note(1) })
      set_row(g, "贴剪贴板图片", fn(r) {
        choice(
          r,
          choice_labels(pin_choices),
          fn() { choice_of(pin_choices, settings.get().pin_key) },
          fn(i) { change_settings(fn(s) { Settings::{ ..s, pin_key: hotkey_of(pin_choices[i]) } }) },
        )
      }, note=fn() { key_note(2) })
      set_row(g, "额外确认并复制", fn(r) {
        choice(
          r,
          choice_labels(confirm_choices),
          fn() { choice_of(confirm_choices, settings.get().confirm_key) },
          fn(i) { change_settings(fn(s) { Settings::{ ..s, confirm_key: hotkey_of(confirm_choices[i]) } }) },
        )
      }, note=fn() { key_note(3) }, note_ink=fn() { set_muted })
    }
  })
  if keys_pressed_in() {
    let _ = p.box(fn(b) {
      let _ = b.padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
      set_words(b, fn() { tr("点一下快捷键框，再按下想用的组合键；Esc 取消。") }, 12.0, set_muted)
      set_words(b, fn() { tr("点 × 清空；清空后仍可从托盘图标截图。") }, 12.0, set_muted)
    })
  }
}

fn choice_of(choices : Array[(String, Int, Int)], h : Hotkey) -> Int {
  for i, c in choices {
    if c.1 == h.mods && c.2 == h.vk {
      return i
    }
  }
  0
}

fn key_note(which : Int) -> String {
  let (row, why) = key_trouble.get()
  if row == which {
    why
  } else if which == 3 {
    if hostapi::platform() == 0 {
      tr("Return、⌘C 与双击始终可用；这里可额外再绑一个单键（如 Space）或组合键")
    } else {
      tr("Enter、Ctrl+C 与双击始终可用；这里可额外再绑一个单键（如 Space）或组合键")
    }
  } else if !(if which == 1 { capture_key_ok.get() } else { pin_key_ok.get() }) {
    tr("已被其他程序占用，换一个")
  } else {
    ""
  }
}

fn key_box(parent : view::View, which : Int) -> Unit {
  let has = fn() {
    let s = settings.get()
    let vk = if which == 1 {
      s.capture_key.vk
    } else if which == 2 {
      s.pin_key.vk
    } else {
      s.confirm_key.vk
    }
    recording.get() != which && vk != 0
  }
  let words = fn() {
    if recording.get() == which {
      tr("按下快捷键…")
    } else if which == 1 {
      key_words(settings.get().capture_key, key_choices)
    } else if which == 2 {
      key_words(settings.get().pin_key, pin_choices)
    } else {
      key_words(settings.get().confirm_key, confirm_choices)
    }
  }
  let box_w = 180.0
  let _ = parent.box(fn(wrap) {
    let _ = wrap
    .width(view::Live::Is(Some(box_w)))
    .height(view::Live::Is(Some(28.0)))
    .shrink(view::Live::Is(0.0))
    let _ = wrap.box(fn(b) {
      hig_focus(b)
      let _ = b
      .width(view::Live::Is(Some(box_w)))
      .height(view::Live::Is(Some(28.0)))
      .padding(view::Live::By(fn() { if has() { (26.0, 0.0, 26.0, 0.0) } else { (12.0, 0.0, 12.0, 0.0) } }))
      .radius(view::Live::Is(8.0))
      .shrink(view::Live::Is(0.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .presses(view::Live::Is(true))
      .cursor(view::Live::Is(Some(view::Cursor::Hand)))
      .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=words())) }))
      .on_press(fn() { record_key(which) })
      .edge(view::Live::By(fn() { (1.0, if recording.get() == which { 0x2F9BFFFFL } else { 0xFFFFFF24L }) }))
      .ground(view::Live::By(fn() {
        if recording.get() == which {
          0x17324FFFL
        } else if b.pointed() {
          0x2B2E36FFL
        } else {
          0x141518FFL
        }
      }))
      let _ = b.box(fn(t) {
        let _ = t
        .words(view::Live::By(words), look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, line: 16.0, wrap: false })
        .ink(view::Live::By(fn() { if recording.get() == which { 0x8CC8FFFFL } else { set_ink } }))
      })
    })
    let _ = wrap.box(fn(clr) {
      let hov = smooth_hover(clr)
      tactile_press(clr, sink_px=0.6)
      hig_focus(clr)
      let _ = clr
      .over(view::Live::Is(true))
      .laid_nowhere(view::Live::By(fn() { !has() }))
      .width(view::Live::Is(Some(20.0)))
      .height(view::Live::Is(Some(20.0)))
      .offset(view::Live::Is((box_w - 24.0, 4.0)))
      .radius(view::Live::Is(10.0))
      .shrink(view::Live::Is(0.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .presses(view::Live::Is(true))
      .cursor(view::Live::Is(Some(view::Cursor::Hand)))
      .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=tr("清空快捷键"))) }))
      .on_press(fn() { clear_key(which) })
      .ground(view::Live::By(fn() {
        if clr.pressed() {
          0xFFFFFF2CL
        } else {
          mix_rgba(0L, 0xFFFFFF1EL, hov())
        }
      }))
      let _ = clr.box(fn(g) {
        let _ = g
        .width(view::Live::Is(Some(9.0)))
        .height(view::Live::Is(Some(9.0)))
        .picture(view::Live::Is(Some(pixels::Vector::{ w: 9.0, h: 9.0, layers: [stroke_layer("M2 2l5 5M7 2l-5 5", 0x000000FFL, 1.35)] })))
        .tint(view::Live::By(fn() { mix_rgba(0x7E8594FFL, 0xFFFFFFFFL, hov()) }))
      })
    })
  })
}

fn capture_page(p : view::View) -> Unit {
  set_group(p, "保存", fn(g) {
    set_row(g, "图片格式", fn(r) {
      choice(r, ["PNG 无损", "JPEG 高清", "JPEG 小体积"], fn() { settings.get().save_format }, fn(i) {
        change_settings(fn(s) { Settings::{ ..s, save_format: i } })
      })
    })
    set_row(g, "每次询问保存位置", fn(r) {
      switch(r, fn() { settings.get().ask_where }, fn(on) { change_settings(fn(s) { Settings::{ ..s, ask_where: on } }) })
    })
    set_row(g, "复制时也保存一份到文件夹", fn(r) {
      switch(r, fn() { settings.get().keep_copies }, fn(on) { change_settings(fn(s) { Settings::{ ..s, keep_copies: on } }) })
    })
    set_row(g, "文件夹", fn(r) {
      let _ = r.box(fn(b) {
        let _ = b.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0)))
        set_words(b, fn() { settings.get().save_dir }, 12.0, set_muted)
      })
      let _ = r.box(fn(btns) {
        let _ = btns.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).shrink(view::Live::Is(0.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        small_button(btns, fn() { tr("更改…") }, fn() {
          let picked = text_of(ps_pick_folder(settings_wid.v, cstr(settings.untracked().save_dir)))
          if picked != "" {
            change_settings(fn(s) { Settings::{ ..s, save_dir: picked } })
          }
        })
        small_button(btns, fn() { tr("打开") }, fn() { ps_reveal(cstr(settings.untracked().save_dir)) })
      })
    })
  })
  set_group(p, "贴图", fn(g) {
    set_row(g, "打开时置顶", fn(r) {
      switch(r, fn() { settings.get().pin_top }, fn(on) { change_settings(fn(s) { Settings::{ ..s, pin_top: on } }) })
    })
    set_row(g, "打开时的不透明度", fn(r) {
      let values = [255, 204, 153]
      choice(r, ["100%", "80%", "60%"], fn() {
        let a = settings.get().pin_alpha
        if a >= 255 {
          0
        } else if a >= 204 {
          1
        } else {
          2
        }
      }, fn(i) { change_settings(fn(s) { Settings::{ ..s, pin_alpha: values[i] } }) })
    })
  })
}

fn about_page(p : view::View) -> Unit {
  set_group(p, "", fn(g) {
    update_settings(g)
  })
  sponsor_card(p)
  let _ = p.box(fn(b) {
    let _ = b.padding(view::Live::Is((4.0, 0.0, 4.0, 0.0))).gap(view::Live::Is(2.0))
    set_words(b, fn() {
      if updates_here() {
        tr("免费、无广告，不收集任何数据；只在检查更新和你点「翻译」时联网。")
      } else {
        tr("免费、无广告，不收集任何数据；只在你点「翻译」时联网。")
      }
    }, 12.0, set_muted)
    set_words(b, fn() { "© 2026 pengx17" }, 12.0, set_muted)
  })
}

fn sponsor_card(parent : view::View) -> Unit {
  let amber = 0xE5A545FFL
  let amber_hi = 0xF5C36BFFL
  let steam = motion::NodeWay::new(0.0)
  let glow = motion::NodeWay::new(1.0)
  let sheen = motion::NodeWay::new(1.0)
  let heart = motion::NodeWay::new(1.0)
  let open_url = fn() {
    ps_open_url(cstr(site_url + "/support?lang=" + (if english.get() { "en" } else { "zh" })))
  }
  let _ = parent.box(fn(card) {
    let hov = smooth_hover(card, ms=180.0)
    tactile_press(card, sink_px=0.6)
    steam.go_from(card, 0.0, 1.0, motion::tween(2600.0, ease=ui::Ease::Linear))
    glow.go_from(card, 0.0, 1.0, motion::tween(900.0, ease=ui::Ease::Out))
    sheen.go_from(card, 0.0, 1.0, motion::tween(820.0, ease=ui::Ease::Out), at=card.cause_at() + 240.0)
    let rise_again : signals::Ref[() -> Unit] = signals::ref_new(fn() { () })
    let keep_rising_fn : signals::Ref[() -> Unit] = signals::ref_new(fn() { () })
    keep_rising_fn.v = fn() {
      steam.go_from(card, 0.0, 1.0, motion::tween(2200.0, ease=ui::Ease::Linear))
      rise_again.v = card.at_moment(card.cause_at() + 2200.0, fn() {
        if card.pointed() {
          (keep_rising_fn.v)()
        }
      }, later=true)
    }
    let keep_rising = fn() { (keep_rising_fn.v)() }
    let _ = card.owns(fn() { (rise_again.v)() })
    let _ = card.reacts(fn() { card.pointed() }, at_start=false, fn(on) {
      if on {
        heart.go_from(card, 0.0, 1.0, motion::tween(1100.0, ease=ui::Ease::Out))
        sheen.go_from(card, 0.0, 1.0, motion::tween(820.0, ease=ui::Ease::Out))
        keep_rising()
      } else {
        (rise_again.v)()
        rise_again.v = fn() {  }
      }
    })
    let _ = card
    .row(view::Live::Is(true))
    .gap(view::Live::Is(12.0))
    .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
    .radius(view::Live::Is(10.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .presses(view::Live::Is(true))
    .cursor(view::Live::Is(Some(view::Cursor::Hand)))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=tr("赞助作者"))) }))
    .on_press(open_url)
    .ground(view::Live::By(fn() { mix_rgba(mix_rgba(set_card, amber, 0.07), mix_rgba(set_card, amber, 0.13), hov()) }))
    .edge(view::Live::By(fn() {
      let g = glow.shown(card)
      let lit = if g < 0.4 { g / 0.4 } else { (1.0 - g) / 0.6 }
      let rest = mix_rgba(0xE5A54538L, 0xF5C36B75L, hov())
      (1.0 + lit, mix_rgba(rest, 0xE5A54580L, lit))
    }))
    let _ = card.box(fn(b) {
      let _ = b
      .width(view::Live::Is(Some(36.0)))
      .height(view::Live::Is(Some(36.0)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(9.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .ground(view::Live::By(fn() { mix_rgba(0xE5A54521L, 0xE5A54533L, hov()) }))
      .edge(view::Live::Is((1.0, 0xE5A54538L)))
      .scale(view::Live::By(fn() { 1.0 + 0.06 * hov() }))
      .drawn_off(view::Live::By(fn() { (0.0, -1.0 * hov()) }))
      let _ = b.box(fn(cup) {
        let _ = cup
        .width(view::Live::Is(Some(18.0)))
        .height(view::Live::Is(Some(18.0)))
        .picture(view::Live::By(fn() {
          let t = steam.shown(cup)
          let still = !steam.goes_at(cup.cause_at())
          let layers = [
            stroke_layer("M2.6 6.4h8.4v3.4a3.2 3.2 0 0 1-3.2 3.2H5.8a3.2 3.2 0 0 1-3.2-3.2Z", amber_hi, 1.45),
            stroke_layer("M11 7.3h0.8a1.6 1.6 0 0 1 0 3.2H11", amber_hi, 1.45),
          ]
          for i, x in [(5.0, 2.4, 1.8), (7.4, 2.1, 2.1), (9.8, 2.4, 1.8)] {
            let (wx, wy, wl) = x
            let (op, dy) = if still {
              (0.55, 0.0)
            } else {
              let ms = t * 2600.0 - i.to_double() * 400.0
              let ph = if ms < 0.0 { 0.0 } else { ms / 2200.0 - (ms / 2200.0).floor() }
              if ph < 0.45 {
                let u = ph / 0.45
                (0.15 + 0.8 * u, 1.2 - 2.0 * u)
              } else {
                let u = (ph - 0.45) / 0.55
                (0.95 - 0.85 * u, -0.8 - 1.6 * u)
              }
            }
            let a = (op * 255.0).round().to_int64()
            layers.push(stroke_layer("M\{num(wx)} \{num(wy + dy)}v\{num(wl)}", (amber_hi & 0xFFFFFF00L) | a, 1.45))
          }
          Some(pixels::Vector::{ w: 16.0, h: 16.0, layers })
        }))
      })
      let _ = b.box(fn(h) {
        let _ = h
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(12.0)))
        .height(view::Live::Is(Some(12.0)))
        .offset(view::Live::Is((28.0, -4.0)))
        .alpha(view::Live::By(fn() {
          let t = heart.shown(h)
          if t < 0.35 {
            t / 0.35
          } else if t < 0.75 {
            1.0 - 0.05 * (t - 0.35) / 0.4
          } else {
            0.95 * (1.0 - t) / 0.25
          }
        }))
        .drawn_off(view::Live::By(fn() {
          let t = heart.shown(h)
          let y = if t < 0.35 { 5.0 - 7.0 * t / 0.35 } else if t < 0.75 { -2.0 - 3.0 * (t - 0.35) / 0.4 } else { -5.0 - 5.0 * (t - 0.75) / 0.25 }
          (0.0, y)
        }))
        .picture(view::Live::Is(Some(pixels::Vector::{ w: 16.0, h: 16.0, layers: [fill_layer("M8 13.7S2 9.8 2 5.6A3.2 3.2 0 0 1 8 3.8a3.2 3.2 0 0 1 6 1.8c0 4.2-6 8.1-6 8.1Z", 0xFF6B7AFFL)] })))
      })
    })
    let _ = card.box(fn(c) {
      let _ = c.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0))
      set_words(c, fn() { tr("赞助作者") }, 13.0, set_ink, weight=600)
      let _ = c.box(fn(d) {
        let _ = d
        .words(view::Live::By(fn() { tr("PinShot 免费使用，觉得好用可以请我喝杯咖啡") }), look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, line: 15.5, wrap: true })
        .ink(view::Live::Is(set_muted))
      })
    })
    let _ = card.box(fn(btn) {
      let _ = btn
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(28.0)))
      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
      .gap(view::Live::Is(4.0))
      .radius(view::Live::Is(7.0))
      .shrink(view::Live::Is(0.0))
      .clips(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .ground(view::Live::By(fn() { mix_rgba(amber, amber_hi, hov()) }))
      .drawn_off(view::Live::By(fn() { (hov(), 0.0) }))
      let _ = btn.box(fn(t) {
        let _ = t.words(view::Live::By(fn() { tr("请喝咖啡") }), look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, line: 16.0, wrap: false }).ink(view::Live::Is(0x16120BFFL))
      })
      let _ = btn.box(fn(a) {
        let _ = a.width(view::Live::Is(Some(12.0))).height(view::Live::Is(Some(12.0))).picture(view::Live::Is(Some(pixels::Vector::{ w: 16.0, h: 16.0, layers: [stroke_layer("M5 11L11 5M6 5h5v5", 0x16120BFFL, 1.8)] })))
      })
      let _ = btn.box(fn(s) {
        let _ = s
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(36.0)))
        .alpha(view::Live::By(fn() {
          let t = sheen.shown(s)
          if t <= 0.0 || t >= 1.0 { 0.0 } else { 1.0 }
        }))
        .drawn_off(view::Live::By(fn() { (-40.0 + 150.0 * sheen.shown(s), 0.0) }))
        .picture(view::Live::Is(Some(pixels::Vector::{ w: 36.0, h: 28.0, layers: [fill_layer("M14 0h10l-12 28h-10z", 0xFFFFFF6BL)] })))
      })
    })
  })
}

fn set_words(parent : view::View, text : () -> String, size : Double, ink : Int64, weight~ : Int = 400) -> Unit {
  let _ = parent.box(fn(w) {
    let _ = w.words(view::Live::By(text), look=view::WordsLook::{ ..view::words_plain, size, weight, line: (size * 1.45).round(), wrap: false }).ink(view::Live::Is(ink))
  })
}

let set_card_rows : signals::Ref[Int] = signals::ref_new(0)

fn set_group(parent : view::View, title : String, make : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(g) {
    let _ = g.gap(view::Live::Is(6.0))
    if title != "" {
      set_words(g, fn() { tr(title) }, 12.0, set_muted, weight=500)
    }
    let _ = g.box(fn(card) {
      let _ = card.ground(view::Live::Is(set_card)).radius(view::Live::Is(12.0)).edge(view::Live::Is((1.0, 0xFFFFFF22L))).padding(view::Live::Is((14.0, 4.0, 14.0, 4.0)))
      let prev = set_card_rows.v
      set_card_rows.v = 0
      make(card)
      set_card_rows.v = prev
    })
  })
}

fn set_row(
  parent : view::View,
  label : String,
  make : (view::View) -> Unit,
  note~ : () -> String  = fn() { "" },
  note_ink~ : () -> Int64  = fn() { 0xE5A545FFL },
) -> Unit {
  if set_card_rows.v > 0 {
    let _ = parent.box(fn(sep) { let _ = sep.height(view::Live::Is(Some(1.0))).ground(view::Live::Is(0xFFFFFF14L)) })
  }
  set_card_rows.v += 1
  let _ = parent.box(fn(row) {
    let _ = row
    .row(view::Live::Is(true))
    .min_height(view::Live::Is(Some(38.0)))
    .padding(view::Live::Is((0.0, 5.0, 0.0, 5.0)))
    .gap(view::Live::Is(12.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    let _ = row.box(fn(l) {
      let _ = l.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0))
      set_words(l, fn() { tr(label) }, 13.0, set_ink)
      let _ = l.box(fn(n) {
        let _ = n
        .laid_nowhere(view::Live::By(fn() { note() == "" }))
        .words(view::Live::By(note), look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, line: 16.0, wrap: true })
        .ink(view::Live::By(note_ink))
      })
    })
    make(row)
  })
}

fn choice(parent : view::View, names : Array[String], at : () -> Int, pick : (Int) -> Unit) -> Unit {
  let _ = parent.box(fn(seg) {
    let _ = seg.row(view::Live::Is(true)).pad(view::Live::Is(2.0)).radius(view::Live::Is(8.0)).ground(view::Live::Is(0x131417FFL)).edge(view::Live::Is((1.0, 0xFFFFFF1AL))).gap(view::Live::Is(2.0)).shrink(view::Live::Is(0.0))
    let views : Map[Int, view::View] = Map::new()
    sliding_thumb(
      seg,
      at,
      views,
      6.0,
      fn() { 0x3D414AFFL },
      extra_watch=fn() { if english.get() { 1 } else { 0 } },
      snap_watch=fn() { settings_tab.get() },
    )
    for i, name in names {
      let _ = seg.box(fn(b) {
        views[i] = b
        let hov = smooth_hover(b)
        let act = motion::eased_on(b, fn() { at() == i }, motion_tween(130.0))
        tactile_press(b, sink_px=0.9)
        hig_focus(b)
        let _ = b
        .height(view::Live::Is(Some(28.0)))
        .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
        .radius(view::Live::Is(6.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .presses(view::Live::Is(true))
        .cursor(view::Live::Is(Some(view::Cursor::Hand)))
        .says(view::Live::By(fn() { Some(view::said(view::Role::Radio, label=tr(name), selected=at() == i)) }))
        .on_press(fn() { pick(i) })
        .ground(view::Live::By(fn() {
          if at() == i {
            0L
          } else {
            mix_rgba(0L, 0xFFFFFF0FL, hov())
          }
        }))
        let _ = b.box(fn(t) {
          let _ = t
          .words(view::Live::By(fn() { tr(name) }), look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, line: 16.0, wrap: false })
          .ink(view::Live::By(fn() { mix_rgba(set_muted, set_ink, dmax(act.shown(t), hov() * 0.45)) }))
        })
      })
    }
  })
}

fn switch(parent : view::View, on : () -> Bool, set : (Bool) -> Unit) -> Unit {
  let _ = parent.box(fn(hit) {
    let knob = motion::NodeWay::new(if signals::untracked(on) { 1.0 } else { 0.0 })
    hit.reacts(on, at_start=false, fn(now) {
      let target = if now { 1.0 } else { 0.0 }
      if reduce_motion() {
        knob.put(target)
      } else {
        knob.go(hit, target, motion::knob_spring)
      }
    })
    tactile_press(hit, sink_px=1.0)
    hig_focus(hit)
    let _ = hit
    .width(view::Live::Is(Some(40.0)))
    .height(view::Live::Is(Some(28.0)))
    .radius(view::Live::Is(12.0))
    .shrink(view::Live::Is(0.0))
    .presses(view::Live::Is(true))
    .cursor(view::Live::Is(Some(view::Cursor::Hand)))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Switch, label="", check=if on() { view::Check::On } else { view::Check::Off })) }))
    .on_press(fn() { set(!on()) })
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    let _ = hit.box(fn(s) {
      let _ = s
      .width(view::Live::Is(Some(36.0)))
      .height(view::Live::Is(Some(20.0)))
      .radius(view::Live::Is(10.0))
      .shrink(view::Live::Is(0.0))
      .presses(view::Live::Is(false))
      .ground(view::Live::By(fn() { mix_rgba(0x454852FFL, 0x2F9BFFFFL, knob.shown(s)) }))
      .lines_up(view::Live::Is(Some(view::Along::Start)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      let _ = s.box(fn(k) {
        let _ = k
        .width(view::Live::Is(Some(16.0)))
        .height(view::Live::Is(Some(16.0)))
        .radius(view::Live::Is(8.0))
        .ground(view::Live::Is(0xFFFFFFFFL))
        .offset(view::Live::Is((2.0, 0.0)))
        .drawn_off(view::Live::By(fn() { (16.0 * knob.shown(k), 0.0) }))
      })
    })
  })
}

fn small_button(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  shown~ : () -> Bool  = fn() { true },
  min_width~ : () -> Option[Double]  = fn() { None },
) -> Unit {
  let _ = parent.box(fn(b) {
    let hov = smooth_hover(b)
    tactile_press(b)
    hig_focus(b)
    let _ = b
    .laid_nowhere(view::Live::By(fn() { !shown() }))
    .min_width(view::Live::By(min_width))
    .height(view::Live::Is(Some(28.0)))
    .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
    .radius(view::Live::Is(8.0))
    .shrink(view::Live::Is(0.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .presses(view::Live::Is(true))
    .cursor(view::Live::Is(Some(view::Cursor::Hand)))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=label())) }))
    .on_press(press)
    .ground(view::Live::By(fn() { if b.pressed() { 0x4E5361FFL } else { mix_rgba(0x353841FFL, 0x444854FFL, hov()) } }))
    .edge(view::Live::Is((1.0, 0xFFFFFF22L)))
    let _ = b.box(fn(t) {
      let _ = t.words(view::Live::By(label), look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, line: 16.0, wrap: false }).ink(view::Live::Is(set_ink))
    })
  })
}
